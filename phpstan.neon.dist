parameters:
    level: 8
    paths:
        - src
    scanDirectories:
        - vendor/symfony/ai-agent/src
    # 1.30 / 1.31: the optional BreadcrumbKit (>= 2.17) port, trail DTOs and event of web_ui.breadcrumb_current_label (not a dependency)
    scanFiles:
        - tests/Stub/BreadcrumbKit/BreadcrumbCurrentLabelInterface.php
        - tests/Stub/BreadcrumbKit/BreadcrumbTrail.php
    excludePaths:
        - src/Resources/assets/*
    treatPhpDocTypesAsCertain: false
    # 1.37 (Beacon spec 239): PhpStanFrankenPhp 1.4 worker load-readiness rules (ruleset-worker.neon is already
    # included, so they are enabled through their parameters). Every wiki write goes through the bundle's transaction runner.
    frankenphp:
        flagRollbackAfterNestedBegin: true
        flagFlushInHandWrittenTransaction: true
        flagUnboundedRecursion: true
        flagFlushWithoutClosedManagerRecovery: true
    # REQ-CS-006: never silence findings here — fix the code instead
    ignoreErrors: []

includes:
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon
    # 1.46: the SearchKit group only where SearchKit (PHP >= 8.3) is installed
    - phpstan-search-kit.php
