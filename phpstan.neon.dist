parameters:
    level: 8
    paths:
        - src
    scanDirectories:
        - vendor/symfony/ai-agent/src
    # 1.30 / 1.31: the optional BreadcrumbKit (>= 2.17) port, trail DTOs and event of web_ui.breadcrumb_current_label (not a dependency)
    scanFiles:
        - tests/Stub/BreadcrumbKit/BreadcrumbCurrentLabelInterface.php
        - tests/Stub/BreadcrumbKit/BreadcrumbTrail.php
    excludePaths:
        - src/Resources/assets/*
    treatPhpDocTypesAsCertain: false
    # REQ-CS-006: never silence findings here — fix the code instead
    ignoreErrors: []

includes:
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon
