<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <!-- Spec 218: SQLite in memory by default; MySQL and PostgreSQL in CI through WIKI_TEST_DATABASE_URL. -->
        <testsuite name="database">
            <directory>tests/Database</directory>
        </testsuite>
        <!-- Spec 218: the REST API through a host kernel; also run on MySQL and PostgreSQL in CI. -->
        <testsuite name="api">
            <directory>tests/Api</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <directory>src/Resources</directory>
            <file>src/Security/WikiAccessCheckerInterface.php</file>
            <file>src/Security/WikiTeamMembershipResolverInterface.php</file>
            <file>src/Security/WikiHtmlSanitizerInterface.php</file>
            <file>src/Service/WikiSpaceAccessResolverInterface.php</file>
        </exclude>
    </source>
    <php>
        <!-- The full suite needs more than PHP's default 128M (audit EP-I9). -->
        <ini name="memory_limit" value="512M"/>
        <!-- REQ-SF-005: fail on direct Symfony deprecations -->
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="max[direct]=0"/>
    </php>
</phpunit>
