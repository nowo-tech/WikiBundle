{#
    Page shell (REQ-UI-001 / REQ-UI-001-kit): extends controller `layout` and stacks Wiki + UiKit CSS/JS with parent().
    FR-006: no inline style block; page-level rules live in wiki.css. Scripts carry the request attribute `csp_nonce` when the host sets it.
#}
{% extends layout %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{# Shared with every block of the page: `framework` (Tabler / Bootstrap draw the pages) or `tokens` (wiki.css draws them). #}
{% set nowo_wiki_skin = nowo_wiki_web_ui.css_framework|default('tabler') in ['tabler', 'bootstrap', 'bootstrap4', 'bootstrap5'] ? 'framework' : 'tokens' %}
{% set nowo_wiki_csp_nonce = app.request.attributes.get('csp_nonce')|default('') %}

{% block stylesheets %}
    {{ parent() }}
    {% block nowo_ui_styles %}
        <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
        <link rel="stylesheet" href="{{ asset('wiki.css', 'nowo_wiki') }}">
    {% endblock %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% block nowo_ui_scripts %}
        <script src="{{ asset('wiki.js', 'nowo_wiki') }}" defer{% if nowo_wiki_csp_nonce %} nonce="{{ nowo_wiki_csp_nonce }}"{% endif %}></script>
    {% endblock %}
    {% block wiki_editor_scripts %}{% endblock %}
{% endblock %}
