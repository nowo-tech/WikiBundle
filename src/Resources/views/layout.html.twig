<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'wiki.title'|trans({}, 'NowoWikiBundle') }}{% endblock %}</title>
    {# Demo root layout: no parent() (full HTML). Package assets stack in base.html.twig. #}
    {% block styles %}
        {% block stylesheets %}
            {% set css_framework = nowo_wiki_web_ui.css_framework|default('tabler') %}
            {% if css_framework in ['tabler', 'bootstrap', 'bootstrap5'] %}
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta20/dist/css/tabler.min.css">
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
            {% endif %}
        {% endblock %}
    {% endblock %}
</head>
<body class="nowo-ui-body nowo-ui-wiki" data-nowo-ui-framework="{{ nowo_wiki_web_ui.css_framework|default('tabler') }}">
<div class="page nowo-ui-page">
    <div class="{% block container_class %}container container-wiki nowo-ui-container{% endblock %} py-4">
        {% block body %}{% endblock %}
    </div>
</div>
{% block javascripts %}
    {% set css_framework = nowo_wiki_web_ui.css_framework|default('tabler') %}
    {% if css_framework in ['tabler', 'bootstrap', 'bootstrap5'] %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    {% endif %}
{% endblock %}
</body>
</html>
