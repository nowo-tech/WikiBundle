{#
  Confirm dialog of the wiki's View\Confirm actions (1.19, dialog rule v2 — owner decision D-20261105-54): delete
  (move to the trash), archive, restore a revision, co-editing reset, purge. Registered by WikiExtension::prepend()
  as the UiKit `confirm` partial of the NowoWikiBundle pages (nowo_ui_kit.theme.bundles.NowoWikiBundle.partials.confirm;
  a host value wins), so the page actions, row actions and list tables render it in place of the kit's
  `partials/_confirm.html.twig`, with the same inputs (id, confirm, action, action_href, framework, bundle,
  nowo_ui_page_type) and the same runtime (js/nowo-ui-confirm.js: [data-nowo-confirm-open] opens, [data-nowo-confirm-close]
  and Escape close).
  Anatomy of every platform dialog (the UiKit `dialog` sections and slots): header with the title and the × close
  button, body with the message, footer outside the body with Cancel (secondary) then the one primary — the confirm
  button posting the action's CSRF form (danger solid for a danger View\Confirm). Medium width (UiKit
  --nowo-dialog-width-md); no height of its own: a yes / no dialog keeps its natural height, capped by UiKit.
  A View\Confirm with expectedValue (type-to-confirm) or a 1.x include without `confirm` falls back to the kit partial.
#}
{% set bundle = bundle|default(null) %}
{% set framework = framework|default(null) %}
{% set _confirm = confirm|default(null) %}
{% if _confirm is null or _confirm.expectedValue is not null %}
    {{- include('@NowoUiKitBundle/partials/_confirm.html.twig', _context, false) -}}
{% else %}
    {% set _id = id|default(_confirm.id) %}
    {% set _cancel = _confirm.cancelLabel is null ? 'action.cancel'|trans({}, 'NowoUiKitBundle') : _confirm.cancelLabel|nowo_ui_trans %}
    {% set _submit = _confirm.confirmLabel is null ? 'action.confirm'|trans({}, 'NowoUiKitBundle') : _confirm.confirmLabel|nowo_ui_trans %}
    {% set _close = 'action.close'|trans({}, 'NowoUiKitBundle') %}
    <dialog id="{{ _id }}" class="{{ nowo_ui_class('dialog', bundle) }} nowo-wiki-confirm" data-nowo-ui-confirm data-testid="wiki-confirm-dialog" aria-labelledby="{{ _id }}-title">
        <header class="{{ nowo_ui_class('dialog_header', bundle) }}"{{ nowo_ui_attrs('dialog_header', bundle) }}>
            <h2 class="{{ nowo_ui_class('dialog_title', bundle) }}" id="{{ _id }}-title"{{ nowo_ui_attrs('dialog_title', bundle) }}>{{ _confirm.title|nowo_ui_trans }}</h2>
            <button type="button" class="nowo-ui-dialog__close" data-nowo-confirm-close aria-label="{{ _close }}" title="{{ _close }}"><span aria-hidden="true">&times;</span></button>
        </header>
        <div class="{{ nowo_ui_class('dialog_body', bundle) }}"{{ nowo_ui_attrs('dialog_body', bundle) }}>
            {%- if _confirm.message is not null %}<p class="nowo-ui-confirm__message">{{ _confirm.message|nowo_ui_trans }}</p>{% endif -%}
        </div>
        <footer class="{{ nowo_ui_class('dialog_footer', bundle) }}"{{ nowo_ui_attrs('dialog_footer', bundle) }}>
            <button type="button" class="{{ nowo_ui_class('btn_secondary', bundle, framework) }}" data-nowo-confirm-close>{{ _cancel }}</button>
            {% if action|default(null) %}
                {{ include('@NowoUiKitBundle/partials/_action_post.html.twig', {
                    action: action,
                    action_href: action_href|default(action.href),
                    button_class: (_confirm.variant == 'danger' ? nowo_ui_class('btn_danger_solid', bundle, framework) : nowo_ui_class('btn_' ~ _confirm.variant, bundle, framework)) ~ ' nowo-ui-confirm__submit',
                    button_attrs: {},
                    button_html: _submit,
                }, false) }}
            {% endif %}
        </footer>
    </dialog>
{% endif %}
