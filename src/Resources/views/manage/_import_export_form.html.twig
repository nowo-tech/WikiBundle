{#
  1.53 (lazy dialogs): the Import & export dialog's content (_import_export_dialog.html.twig), answered by the GET of the
  space_import route to a dialog request, and the body of its full page (import_export.html.twig): the intro, the
  Outline / Notion export links (users who may export), the import form (users who may import; posted to space_import)
  and Cancel then Import, which the dialog moves into its footer (Cancel only without the import form; on the full
  page, back to the space).
  Variables: import_form (WikiImportType view or null), export_links (WikiPageFactory::exportLinks()), bundle.
  Optional: space_href (full page: the Cancel link).
#}
{% trans_default_domain 'NowoWikiBundle' %}
{% set _form_id = 'nowo-wiki-import-export-form' %}
<p class="{{ nowo_ui_class('muted', bundle) }}">{{ 'wiki.import_export.intro'|trans }}</p>
{% if export_links is not empty %}
    <p class="nowo-wiki-import-export__export" data-testid="wiki-export-links">
        {% for link in export_links %}
            <a href="{{ link.href }}" class="{{ nowo_ui_class('btn_secondary', bundle) }}" data-testid="wiki-export-{{ link.format }}">{{ link.label|trans }}</a>
        {% endfor %}
    </p>
{% endif %}
{% if import_form %}
    {{ form_start(import_form, {attr: {id: _form_id, class: nowo_ui_class('form', bundle) ~ ' nowo-wiki-import-export__import', 'data-testid': 'wiki-import-form'}}) }}
        {{ form_errors(import_form) }}
        {% for child in import_form %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    {{ form_end(import_form) }}
    <p class="{{ nowo_ui_class('muted', bundle) }}">{{ 'wiki.import.help'|trans }}</p>
{% endif %}
<div class="{{ nowo_ui_class('form_actions', bundle) }}" data-nowo-ui-dialog-actions>
    {% if space_href|default(null) %}
        <a class="{{ nowo_ui_class('btn_secondary', bundle) }}" href="{{ space_href }}">{{ 'wiki.action.cancel'|trans }}</a>
    {% else %}
        <button type="button" class="{{ nowo_ui_class('btn_secondary', bundle) }}" data-nowo-ui-dialog-close>{{ 'wiki.action.cancel'|trans }}</button>
    {% endif %}
    {% if import_form %}
        <button type="submit" class="{{ nowo_ui_class('btn_primary', bundle) }}" form="{{ _form_id }}" data-testid="wiki-import-submit">{{ 'wiki.import.submit'|trans }}</button>
    {% endif %}
</div>
