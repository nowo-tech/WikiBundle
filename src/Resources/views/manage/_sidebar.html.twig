{#
  Space sidebar of the space and page views: the page tree in a UiKit card (slots card, card_header, card_title,
  card_body), the truncation notice with a link to the space search. Variables: tree (value-free nodes),
  tree_truncated, max_tree_pages, tree_search_href (null = no link), bundle, actions (optional list of View\Action
  printed in the header, e.g. New page).
#}
{% trans_default_domain 'NowoWikiBundle' %}
<aside class="{{ nowo_ui_class('card', bundle) }} nowo-wiki-sidebar" data-wiki-sidebar{{ nowo_ui_attrs('card', bundle) }}>
    <header class="{{ nowo_ui_class('card_header', bundle) }} nowo-wiki-sidebar__header">
        <h2 class="{{ nowo_ui_class('card_title', bundle) }} nowo-wiki-region-title">{{ 'wiki.space.pages'|trans }}</h2>
    </header>
    <nav class="{{ nowo_ui_class('card_body', bundle) }} nowo-wiki-sidebar__body" aria-label="{{ 'wiki.space.pages'|trans }}">
        {% if tree is empty %}
            <p class="{{ nowo_ui_class('muted', bundle) }}">{{ 'wiki.space.no_pages'|trans }}</p>
        {% else %}
            {{ include('@NowoWikiBundle/manage/_page_tree.html.twig', {nodes: tree, depth: 0}, false) }}
        {% endif %}
        {% if tree_truncated|default(false) %}
            <p class="{{ nowo_ui_class('muted', bundle) }} nowo-wiki-tree__truncated">
                {{ 'wiki.space.tree_truncated'|trans({'%count%': max_tree_pages|default(0)}) }}
                {% if tree_search_href|default(null) %}<a href="{{ tree_search_href }}">{{ 'wiki.search.title'|trans }}</a>{% endif %}
            </p>
        {% endif %}
    </nav>
</aside>
