{#
  Space sidebar of the space and page views: the page tree in a UiKit card (slots card, card_header, card_title,
  card_body), the truncation notice with a link to the space search. Variables: tree (value-free nodes),
  tree_truncated, max_tree_pages, tree_search_href (null = no link), bundle, actions (optional list of View\Action
  printed in the header, e.g. New page). 1.32: space_icon (UX icon name of the space, optional; nothing is shown when null) is shown before the title.
  1.14: tree_ui ({nodes, attr, movable} from WikiPageFactory::uiTree() / treeAttributes(), tree.enabled) renders the
  UiKit `tree` partial instead of the nested list (disclosures, fold state, moves; js/nowo-ui-tree.js + wiki.js).
  1.29: tree_rail (WikiTreeRail::rail(), web_ui.tree_rail; null = as before) makes the card a UiKit rail host
  (data-nowo-ui-rail-host): the UiKit `rail_toggle` partial in the header ("Collapse Pages" / "Expand Pages",
  aria-controls the body, aria-expanded; a link to ?tree=rail|full without JavaScript; js/nowo-ui-rail.js stores the
  state through the panel state endpoint, or localStorage without a session); the title and the body are
  data-nowo-ui-rail-body (display: none in the rail, so out of the tab order); the rail shows "Pages" vertically.
#}
{% trans_default_domain 'NowoWikiBundle' %}
{% set _rail = tree_rail|default(null) %}
<aside class="{{ nowo_ui_class('card', bundle) }} nowo-wiki-sidebar"{% if _rail %} id="{{ _rail.id }}" data-nowo-ui-rail-host data-nowo-ui-rail="{{ _rail.collapsed ? 'collapsed' : 'expanded' }}"{% endif %} data-wiki-sidebar{{ nowo_ui_attrs('card', bundle) }}>
    <header class="{{ nowo_ui_class('card_header', bundle) }} nowo-wiki-sidebar__header">
        <h2 class="{{ nowo_ui_class('card_title', bundle) }} nowo-wiki-region-title"{% if _rail %} data-nowo-ui-rail-body{% endif %}>{% if space_icon|default(null) %}<span class="nowo-wiki-space-icon" aria-hidden="true">{{ include('@NowoUiKitBundle/components/_icon.html.twig', {name: space_icon, label: ''}, false)|trim|raw }}</span>{% endif %}{{ 'wiki.space.pages'|trans }}</h2>
        {% if _rail %}
            {{ include(nowo_ui_partial('rail_toggle', bundle), {
                target: _rail.body_id,
                title: 'wiki.space.pages'|trans,
                collapsed: _rail.collapsed,
                href: _rail.href,
                persist: _rail.persist,
                state_url: _rail.state_url,
                state_token: _rail.state_token,
                state_panel: _rail.state_panel,
                attr: {'data-testid': 'wiki-tree-rail-toggle'},
                bundle: bundle,
            }, false) }}
        {% endif %}
    </header>
    <nav class="{{ nowo_ui_class('card_body', bundle) }} nowo-wiki-sidebar__body"{% if _rail %} id="{{ _rail.body_id }}" data-nowo-ui-rail-body{% endif %} aria-label="{{ 'wiki.space.pages'|trans }}">
        {% if tree is empty %}
            <p class="{{ nowo_ui_class('muted', bundle) }}">{{ 'wiki.space.no_pages'|trans }}</p>
        {% elseif tree_ui|default(null) %}
            {{ include(nowo_ui_partial('tree', bundle), {nodes: tree_ui.nodes, label: 'wiki.space.pages'|trans, attr: tree_ui.attr|merge({'data-wiki-tree-error': 'wiki.tree.error.failed'|trans}), movable: tree_ui.movable, bundle: bundle}, false) }}
        {% else %}
            {{ include('@NowoWikiBundle/manage/_page_tree.html.twig', {nodes: tree, depth: 0}, false) }}
        {% endif %}
        {% if tree_truncated|default(false) %}
            <p class="{{ nowo_ui_class('muted', bundle) }} nowo-wiki-tree__truncated">
                {{ 'wiki.space.tree_truncated'|trans({'%count%': max_tree_pages|default(0)}) }}
                {% if tree_search_href|default(null) %}<a href="{{ tree_search_href }}">{{ 'wiki.search.title'|trans }}</a>{% endif %}
            </p>
        {% endif %}
    </nav>
</aside>
