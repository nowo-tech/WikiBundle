{#
  Revision diff (REQ-UI-003): UiKit show scaffold. Variable: page (View\ShowPage from WikiPageFactory::diff(): header
  wiki.diff.title / wiki.diff.range with a back link to the history, breadcrumbs). Also: diff (list of {kind: same |
  add | remove, line}). Each added / removed line starts with a +/- marker (aria-hidden) and its meaning for screen
  readers ("Added:" / "Removed:", class nowo-wiki-sr-only, hidden by wiki.css).
  1.45: rendered_diff ({html, changes, fallback}, history.rendered_diff with two Markdown revisions; null otherwise):
  the editor's rendered diff (blocks, word-level <ins> / <del>, visually hidden "Inserted:" / "Deleted:" labels),
  already rendered for the viewer and sanitized by WikiRenderedRevisionDiff; printed instead of the lines.
  Blocks filled: nowo_ui_styles, nowo_ui_show_sections (one card with the diff lines).
#}
{% extends '@NowoUiKit/page/show.html.twig' %}
{% trans_default_domain 'NowoWikiBundle' %}

{% block nowo_ui_styles %}
    {#- 1.21 web_ui.assets.styles: false = the host bundles the assets (nothing printed here) -#}
    {% if nowo_wiki_web_ui.assets.styles ?? true %}
        {{ parent() }}
        <link rel="stylesheet" href="{{ asset('wiki.css', 'nowo_wiki') }}">
    {% endif %}
{% endblock %}

{% block nowo_ui_scripts %}
    {#- 1.21 web_ui.assets.scripts: false = the host bundles the assets (nothing printed here) -#}
    {% if nowo_wiki_web_ui.assets.scripts ?? true %}
        {{ parent() }}
        {#- 1.45: the editor's read-side styles of the rendered diff (.nowo-md-diff-*) -#}
        {% if rendered_diff|default(null) %}{{ nowo_wiki_rich_content_assets() }}{% endif %}
    {% endif %}
{% endblock %}

{% block nowo_ui_show_sections %}
    {% set _b = page.bundle %}
    <section class="{{ nowo_ui_class('card', _b) }} nowo-wiki-diff{{ rendered_diff|default(null) ? ' nowo-wiki-diff--rendered' }}"{{ nowo_ui_attrs('card', _b) }}>
        <div class="{{ nowo_ui_class('card_body', _b) }}">
            {% if rendered_diff|default(null) %}
                {#- 1.45 (history.rendered_diff): the editor's diff, rendered for the viewer and sanitized (safe HTML) -#}
                <div class="nowo-wiki-content nowo-wiki-diff__rendered" data-testid="wiki-rendered-diff" data-wiki-diff-changes="{{ rendered_diff.changes }}"{% if rendered_diff.fallback %} data-wiki-diff-fallback{% endif %}>{{ rendered_diff.html|raw }}</div>
            {% elseif diff is empty %}
                <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'wiki.diff.empty'|trans }}</p>
            {% else %}
                <pre class="{{ nowo_ui_class('code_block', _b) }} nowo-wiki-diff__lines">
                    {%- for line in diff -%}
                        <span class="nowo-wiki-diff__line nowo-wiki-diff__line--{{ line.kind }}" data-wiki-diff="{{ line.kind }}">
                            {%- if line.kind == 'add' %}<span class="nowo-wiki-sr-only visually-hidden">{{ 'wiki.diff.added'|trans }}</span><span class="nowo-wiki-diff__marker" aria-hidden="true">+ </span>{% elseif line.kind == 'remove' %}<span class="nowo-wiki-sr-only visually-hidden">{{ 'wiki.diff.removed'|trans }}</span><span class="nowo-wiki-diff__marker" aria-hidden="true">- </span>{% else %}<span class="nowo-wiki-diff__marker" aria-hidden="true">  </span>{% endif -%}
                            {{ line.line }}</span>
                    {%- endfor -%}
                </pre>
            {% endif %}
        </div>
    </section>
{% endblock %}
