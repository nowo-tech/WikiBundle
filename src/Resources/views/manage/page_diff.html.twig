{% extends '@NowoWikiBundle/base.html.twig' %}

{% block title %}{{ 'wiki.diff.title'|trans({}, 'NowoWikiBundle') }}{% endblock %}

{% block container_class %}container container-narrow nowo-wiki-container nowo-wiki-container--narrow{% endblock %}

{% block body %}
    <div class="nowo-wiki nowo-wiki--diff" data-nowo-wiki-skin="{{ nowo_wiki_skin|default('framework') }}">
        {% block wiki_header %}
            {{ include('@NowoWikiBundle/manage/_page_header.html.twig', {
                page_title: 'wiki.diff.title'|trans({}, 'NowoWikiBundle'),
                page_subtitle: 'v' ~ from_revision.revisionNumber ~ ' → v' ~ to_revision.revisionNumber,
            }) }}
        {% endblock %}

        <section class="card nowo-wiki-panel nowo-wiki-diff">
            {% block diff_body %}
                <div class="card-body wiki-diff-list nowo-wiki-panel__body nowo-wiki-diff__lines">
                    {% for line in diff %}
                        <span class="wiki-diff-{{ line.kind }} nowo-wiki-diff__line nowo-wiki-diff__line--{{ line.kind }}">{{ line.kind|upper }} {{ line.line }}</span>
                    {% endfor %}
                </div>
            {% endblock %}
            {% block diff_footer %}
                <div class="card-footer nowo-wiki-panel__footer nowo-wiki-actions">
                    <a href="{{ path(routes.page_history.name, {spaceSlug: space.slug, pageSlug: page.slug}) }}" class="btn btn-outline-secondary nowo-wiki-btn nowo-wiki-btn--secondary">
                        <i class="ti ti-arrow-left me-1 nowo-wiki-icon" aria-hidden="true"></i>{{ 'wiki.history.title'|trans({}, 'NowoWikiBundle') }}
                    </a>
                </div>
            {% endblock %}
        </section>
    </div>
{% endblock %}
