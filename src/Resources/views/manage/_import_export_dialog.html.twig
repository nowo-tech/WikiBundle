{#
  Import & export dialog of the space home (1.21, web_ui.import_export: dialog). Since 1.53 (lazy dialogs) an EMPTY UiKit
  `remote_form_dialog`, medium size: the "Import & export" header action is a link to the dialog's own page (GET of the
  space_import route, `import_export_src`), which js/nowo-ui-dialog.js loads with `X-Nowo-Dialog: 1` when the dialog
  opens (_import_export_form.html.twig: the intro, the Outline / Notion export links, the import form with Cancel then
  Import in the footer). The import posts inside the dialog; the space page then reloads with the import report.
  Without JavaScript the link opens the full page (import_export.html.twig).
  Variables: import_export_src (URL, 1.53), bundle. Deprecated since 1.53: without import_export_src, import_form
  (WikiImportType view or null) and export_links render the 1.21 inline dialog.
#}
{% trans_default_domain 'NowoWikiBundle' %}
{% if import_export_src|default(null) %}
    {{ include(nowo_ui_partial('remote_form_dialog', bundle), {
        id: 'nowo-wiki-import-export-dialog',
        title: 'wiki.import_export.title'|trans,
        size: 'md',
        bundle: bundle,
        attr: {'data-testid': 'wiki-import-export-dialog'},
    }, false) }}
{% else %}
{% set _form_id = 'nowo-wiki-import-export-form' %}
{% set _footer %}
    <button type="button" class="{{ nowo_ui_class('btn_secondary', bundle) }}" data-nowo-ui-dialog-close>{{ 'wiki.action.cancel'|trans }}</button>
    {% if import_form %}
        <button type="submit" class="{{ nowo_ui_class('btn_primary', bundle) }}" form="{{ _form_id }}" data-testid="wiki-import-submit">{{ 'wiki.import.submit'|trans }}</button>
    {% endif %}
{% endset %}
{% set _body %}
    <p class="{{ nowo_ui_class('muted', bundle) }}">{{ 'wiki.import_export.intro'|trans }}</p>
    {% if export_links is not empty %}
        <p class="nowo-wiki-import-export__export" data-testid="wiki-export-links">
            {% for link in export_links %}
                <a href="{{ link.href }}" class="{{ nowo_ui_class('btn_secondary', bundle) }}" data-testid="wiki-export-{{ link.format }}">{{ link.label|trans }}</a>
            {% endfor %}
        </p>
    {% endif %}
    {% if import_form %}
        {{ form_start(import_form, {attr: {id: _form_id, class: nowo_ui_class('form', bundle) ~ ' nowo-wiki-import-export__import', 'data-testid': 'wiki-import-form'}}) }}
            {% for child in import_form %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
        {{ form_end(import_form) }}
        <p class="{{ nowo_ui_class('muted', bundle) }}">{{ 'wiki.import.help'|trans }}</p>
    {% endif %}
{% endset %}
{{ include(nowo_ui_partial('dialog', bundle), {
    id: 'nowo-wiki-import-export-dialog',
    title: 'wiki.import_export.title'|trans,
    size: 'md',
    body: _body,
    footer: _footer,
    bundle: bundle,
    nowo_ui_page_type: nowo_ui_page_type|default(null),
    attr: {'data-testid': 'wiki-import-export-dialog'},
}, false) }}
{% endif %}
