{#
  1.39 (tree.context_menu): the page tree's context menu (one ARIA menu for every row) and the "Change icon" dialog.
  wiki.js (wiki-tree-menu.ts) opens the menu from a right click on a row, the row's «…» button, the ContextMenu key /
  Shift+F10 on a row, or (1.41) a long press on a touch screen; shows only the entries the row is marked with
  (WikiTreeMenu, WikiNewPageMenu); moves the focus with the arrows, Home and End; Escape / Tab / a click outside close
  it and give the focus back to the row.
  - Open in new tab (1.41): the page in a new tab. Edit (1.41): the page's edit form.
  - Rename: the row's title becomes a text field (Enter saves, Escape cancels) posted to the tree's rename endpoint.
  - Change icon / emoji: the dialog below with the page icon field (text input or the IconSelector picker), posted
    to the tree's icon endpoint. 1.53 (lazy dialogs): the page holds no form; each time the dialog opens wiki.js loads
    it from `tree_menu.icon_src` (the space page, ?dialog=tree-icon, X-Nowo-Dialog: 1; _tree_menu_form.html.twig).
  - Add child page / New page above / New page below (1.41: two entries, with or without the new-page dialog): the
    new-page dialog when the page has it, else the new-page form with ?place=.
  - Duplicate (1.41): a copy of the page right below it (the tree's duplicate endpoint), then the copy opens.
  - Move up / Move down (1.41): the tree's Alt+arrow moves. Move to… (1.41): the dialog below with the parents the
    tree's parents endpoint offers; the tree's move endpoint moves it. 1.53: its form loads from `tree_menu.move_src`
    (?dialog=tree-move) when it opens, as the icon's.
  - Copy link: the page's address to the clipboard.
  - Archive (1.41): behind the confirm dialog below; then the undo line offers Unarchive. Delete (1.41, trash.enabled):
    behind the confirm dialog, which says how many pages go to the trash.
  - The confirm dialog of Archive / Delete is a bare confirm: no form, its sentence is written in when it opens.
  Variables: tree_menu ({icon_src: URL|null, move_src: URL|null (1.53), dialog: bool, items: {edit, rename, icon,
  create, move, archive, delete}}), bundle, nowo_ui_page_type. Without `items` (a host's 1.39 / 1.40 variables) the
  1.40 entries. 2.0: icon_form / move_form (FormView, the inline forms of 1.39–1.52) are no longer rendered.
#}
{% trans_default_domain 'NowoWikiBundle' %}
<div class="nowo-wiki-tree-menu" id="nowo-wiki-tree-menu" role="menu" aria-label="{{ 'wiki.tree_menu.menu'|trans }}" hidden data-wiki-tree-menu data-testid="wiki-tree-menu"
     data-copied="{{ 'wiki.tree_menu.copied'|trans }}" data-copy-failed="{{ 'wiki.tree_menu.copy_failed'|trans }}" data-rename-label="{{ 'wiki.tree_menu.rename_field'|trans }}" data-failed="{{ 'wiki.tree.error.failed'|trans }}"
     data-denied="{{ 'wiki.tree_menu.error.denied'|trans }}" data-archive-confirm="{{ 'wiki.tree_menu.archive_confirm'|trans }}">
    {% set _can = tree_menu.items|default({rename: true, create: true}) %}
    {% set _groups = [
        [['open', true], ['edit', _can.edit|default(false)], ['rename', _can.rename|default(false)], ['icon', tree_menu.icon_src|default(null) is not null]],
        [['child', _can.create|default(false)], ['above', _can.create|default(false) and (tree_menu.items is defined or tree_menu.dialog|default(false))], ['below', _can.create|default(false)], ['duplicate', _can.create|default(false) and tree_menu.items is defined]],
        [['up', _can.move|default(false)], ['down', _can.move|default(false)], ['moveto', _can.move|default(false) and tree_menu.move_src|default(null) is not null]],
        [['copy', true]],
        [['archive', _can.archive|default(false)], ['delete', _can.delete|default(false)]],
    ] %}
    {% set _labels = {open: 'wiki.tree_menu.open'|trans, edit: 'wiki.tree_menu.edit'|trans, rename: 'wiki.tree_menu.rename'|trans, icon: 'wiki.tree_menu.icon'|trans, child: 'wiki.tree_menu.child'|trans, above: 'wiki.tree_menu.above'|trans, below: 'wiki.tree_menu.below'|trans, duplicate: 'wiki.tree_menu.duplicate'|trans, up: 'wiki.tree_menu.up'|trans, down: 'wiki.tree_menu.down'|trans, moveto: 'wiki.tree_menu.moveto'|trans, copy: 'wiki.tree_menu.copy'|trans, archive: 'wiki.tree_menu.archive'|trans, delete: 'wiki.tree_menu.delete'|trans} %}
    {% for _group in _groups %}
        {% set _shown = _group|filter(e => e[1]) %}
        {% if _shown is not empty %}
            {% if not loop.first %}<div class="nowo-wiki-tree-menu__separator" role="separator" hidden data-wiki-tree-menu-separator></div>{% endif %}
            {% for _entry in _shown %}
                {% set item = _entry[0] %}
                <button type="button" class="nowo-wiki-tree-menu__item{{ item == 'delete' ? ' nowo-wiki-tree-menu__item--danger' }}" role="menuitem" tabindex="-1" hidden data-wiki-tree-menu-item="{{ item }}" data-testid="wiki-tree-menu-{{ item }}">{{ attribute(_labels, item) }}</button>
            {% endfor %}
        {% endif %}
    {% endfor %}
</div>
<p class="nowo-wiki-sr-only" role="status" aria-live="polite" data-wiki-tree-menu-status data-testid="wiki-tree-menu-status"></p>
{% if tree_menu.icon_src|default(null) %}
    {% set _footer %}
        <button type="button" class="{{ nowo_ui_class('btn_secondary', bundle) }}" data-nowo-ui-dialog-close>{{ 'wiki.action.cancel'|trans }}</button>
        <button type="submit" class="{{ nowo_ui_class('btn_primary', bundle) }}" form="nowo-wiki-tree-icon-form" data-testid="wiki-tree-icon-save">{{ 'wiki.tree_menu.icon_save'|trans }}</button>
    {% endset %}
    {% set _body %}
        <p class="{{ nowo_ui_class('muted', bundle) }}" data-wiki-tree-icon-context data-template="{{ 'wiki.tree_menu.icon_context'|trans }}"></p>
        <div data-wiki-tree-icon-slot></div>
        <p class="nowo-wiki-tree-icon__error" role="alert" hidden data-wiki-tree-icon-error data-testid="wiki-tree-icon-error"></p>
    {% endset %}
    {{ include(nowo_ui_partial('dialog', bundle), {
        id: 'nowo-wiki-tree-icon-dialog',
        title: 'wiki.tree_menu.icon_title'|trans,
        size: 'medium',
        body: _body,
        footer: _footer,
        backdrop_close: false,
        bundle: bundle,
        nowo_ui_page_type: nowo_ui_page_type|default(null),
        attr: {'data-testid': 'wiki-tree-icon-dialog', 'data-wiki-tree-icon-dialog': true, 'data-wiki-tree-icon-src': tree_menu.icon_src},
    }, false) }}
{% endif %}
{% if (tree_menu.items.archive|default(false)) or (tree_menu.items.delete|default(false)) %}
    {% set _footer %}
        <button type="button" class="{{ nowo_ui_class('btn_secondary', bundle) }}" data-nowo-ui-dialog-close>{{ 'wiki.action.cancel'|trans }}</button>
        <button type="button" class="{{ nowo_ui_class('btn_danger', bundle) }}" data-wiki-tree-confirm-ok data-delete="{{ 'wiki.tree_menu.delete'|trans }}" data-archive="{{ 'wiki.tree_menu.archive'|trans }}" data-testid="wiki-tree-confirm-ok"></button>
    {% endset %}
    {% set _body %}
        <p data-wiki-tree-confirm-message data-testid="wiki-tree-confirm-message"></p>
        <p class="nowo-wiki-tree-icon__error" role="alert" hidden data-wiki-tree-confirm-error data-testid="wiki-tree-confirm-error"></p>
    {% endset %}
    {{ include(nowo_ui_partial('dialog', bundle), {
        id: 'nowo-wiki-tree-confirm-dialog',
        title: 'wiki.tree_menu.confirm_title'|trans,
        size: 'medium',
        body: _body,
        footer: _footer,
        backdrop_close: false,
        bundle: bundle,
        nowo_ui_page_type: nowo_ui_page_type|default(null),
        attr: {'data-testid': 'wiki-tree-confirm-dialog', 'data-wiki-tree-confirm-dialog': true},
    }, false) }}
{% endif %}
{% if tree_menu.items.archive|default(false) %}
    <div class="{{ nowo_ui_class('flash_info', bundle) }} nowo-wiki-tree-undo" hidden data-wiki-tree-undo data-testid="wiki-tree-undo">
        <span data-wiki-tree-undo-text></span>
        <button type="button" class="{{ nowo_ui_class('btn_link', bundle) }}" data-wiki-tree-undo-button data-testid="wiki-tree-undo-button">{{ 'wiki.tree_menu.unarchive'|trans }}</button>
    </div>
{% endif %}
{% if tree_menu.move_src|default(null) %}
    {% set _footer %}
        <button type="button" class="{{ nowo_ui_class('btn_secondary', bundle) }}" data-nowo-ui-dialog-close>{{ 'wiki.action.cancel'|trans }}</button>
        <button type="submit" class="{{ nowo_ui_class('btn_primary', bundle) }}" form="nowo-wiki-tree-move-form" data-testid="wiki-tree-move-save">{{ 'wiki.tree.move'|trans }}</button>
    {% endset %}
    {% set _body %}
        <p class="{{ nowo_ui_class('muted', bundle) }}" data-wiki-tree-move-context data-template="{{ 'wiki.tree_menu.icon_context'|trans }}" data-root="{{ 'wiki.tree.move_root'|trans }}"></p>
        <div data-wiki-tree-move-slot></div>
        <p class="nowo-wiki-tree-icon__error" role="alert" hidden data-wiki-tree-move-error data-testid="wiki-tree-move-error"></p>
    {% endset %}
    {{ include(nowo_ui_partial('dialog', bundle), {
        id: 'nowo-wiki-tree-move-dialog',
        title: 'wiki.tree_menu.moveto_title'|trans,
        size: 'medium',
        body: _body,
        footer: _footer,
        backdrop_close: false,
        bundle: bundle,
        nowo_ui_page_type: nowo_ui_page_type|default(null),
        attr: {'data-testid': 'wiki-tree-move-dialog', 'data-wiki-tree-move-dialog': true, 'data-wiki-tree-move-src': tree_menu.move_src},
    }, false) }}
{% endif %}
