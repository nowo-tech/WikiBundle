{#
  1.39 (tree.context_menu): the page tree's context menu (one ARIA menu for every row) and the "Change icon" dialog.
  wiki.js (wiki-tree-menu.ts) opens the menu from a right click on a row, the row's «…» button, or the ContextMenu key /
  Shift+F10 on a row; shows only the entries the row is marked with (WikiTreeMenu, WikiNewPageMenu); moves the focus
  with the arrows, Home and End; Escape / Tab / a click outside close it and give the focus back to the row.
  - Rename: the row's title becomes a text field (Enter saves, Escape cancels) posted to the tree's rename endpoint.
  - Change icon / emoji: the dialog below with the page icon field (text input or the IconSelector picker), posted
    to the tree's icon endpoint; the field lives in a <template> and is copied in each time the dialog opens.
  - Add child page / Add sibling page (and "above" with web_ui.new_page_dialog): the new-page dialog when the page has
    it, else the new-page form with ?place=.
  - Copy link: the page's address to the clipboard.
  Variables: tree_menu ({icon_form: FormView|null, dialog: bool}), bundle, nowo_ui_page_type.
#}
{% trans_default_domain 'NowoWikiBundle' %}
<div class="nowo-wiki-tree-menu" id="nowo-wiki-tree-menu" role="menu" aria-label="{{ 'wiki.tree_menu.menu'|trans }}" hidden data-wiki-tree-menu data-testid="wiki-tree-menu"
     data-copied="{{ 'wiki.tree_menu.copied'|trans }}" data-copy-failed="{{ 'wiki.tree_menu.copy_failed'|trans }}" data-rename-label="{{ 'wiki.tree_menu.rename_field'|trans }}" data-failed="{{ 'wiki.tree.error.failed'|trans }}">
    {% set _items = ['rename'] %}
    {% if tree_menu.icon_form|default(null) %}{% set _items = _items|merge(['icon']) %}{% endif %}
    {% set _items = _items|merge(['child', 'below']) %}
    {% if tree_menu.dialog|default(false) %}{% set _items = _items|merge(['above']) %}{% endif %}
    {% set _items = _items|merge(['copy']) %}
    {% set _labels = {rename: 'wiki.tree_menu.rename'|trans, icon: 'wiki.tree_menu.icon'|trans, child: 'wiki.tree_menu.child'|trans, below: 'wiki.tree_menu.below'|trans, above: 'wiki.tree_menu.above'|trans, copy: 'wiki.tree_menu.copy'|trans} %}
    {% for item in _items %}
        <button type="button" class="nowo-wiki-tree-menu__item" role="menuitem" tabindex="-1" hidden data-wiki-tree-menu-item="{{ item }}" data-testid="wiki-tree-menu-{{ item }}">{{ attribute(_labels, item) }}</button>
    {% endfor %}
</div>
<p class="nowo-wiki-sr-only" role="status" aria-live="polite" data-wiki-tree-menu-status data-testid="wiki-tree-menu-status"></p>
{% if tree_menu.icon_form|default(null) %}
    {% set _form = tree_menu.icon_form %}
    {% set _footer %}
        <button type="button" class="{{ nowo_ui_class('btn_secondary', bundle) }}" data-nowo-ui-dialog-close>{{ 'wiki.action.cancel'|trans }}</button>
        <button type="submit" class="{{ nowo_ui_class('btn_primary', bundle) }}" form="nowo-wiki-tree-icon-form" data-testid="wiki-tree-icon-save">{{ 'wiki.tree_menu.icon_save'|trans }}</button>
    {% endset %}
    {% set _body %}
        <p class="{{ nowo_ui_class('muted', bundle) }}" data-wiki-tree-icon-context data-template="{{ 'wiki.tree_menu.icon_context'|trans }}"></p>
        <template data-wiki-tree-icon-template>
            {{ form_start(_form, {attr: {id: 'nowo-wiki-tree-icon-form', class: nowo_ui_class('form', bundle), 'data-testid': 'wiki-tree-icon-form', novalidate: 'novalidate'}}) }}
                {% for child in _form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(_form) }}
        </template>
        <div data-wiki-tree-icon-slot></div>
        <p class="nowo-wiki-tree-icon__error" role="alert" hidden data-wiki-tree-icon-error data-testid="wiki-tree-icon-error"></p>
    {% endset %}
    {{ include(nowo_ui_partial('dialog', bundle), {
        id: 'nowo-wiki-tree-icon-dialog',
        title: 'wiki.tree_menu.icon_title'|trans,
        size: 'medium',
        body: _body,
        footer: _footer,
        backdrop_close: false,
        bundle: bundle,
        nowo_ui_page_type: nowo_ui_page_type|default(null),
        attr: {'data-testid': 'wiki-tree-icon-dialog', 'data-wiki-tree-icon-dialog': true},
    }, false) }}
{% endif %}
