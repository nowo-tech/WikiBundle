{#
  AI question (REQ-UI-003): UiKit form scaffold. Variable: page (View\FormPage from WikiPageFactory::aiAsk(): header
  wiki.ai.title / intro, breadcrumbs; form = WikiAiAskType (space, question, CSRF token wiki_ai_ask); submit
  wiki.ai.submit, or wiki.ai.follow_up once answered).
  Also: error (translation key or null), question, answer (string or null), sources (WikiPageFactory::hits(): pages
  the user may read only).
  Blocks filled: nowo_ui_styles, nowo_ui_form_body (the error, then the REQ-TWIG-003 child loop and
  the help), nowo_ui_form_aside (the answer and its sources).
#}
{% extends '@NowoUiKit/page/form.html.twig' %}
{% trans_default_domain 'NowoWikiBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('wiki.css', 'nowo_wiki') }}">
{% endblock %}

{% block nowo_ui_form_body %}
    {% if error|default(null) %}
        <div class="{{ nowo_ui_class('flash_warning', page.bundle) }}" role="alert" data-testid="wiki-ai-error">{{ error|trans }}</div>
    {% endif %}
    {{ parent() }}
    <p class="{{ nowo_ui_class('muted', page.bundle) }}">{{ 'wiki.ai.help'|trans }}</p>
{% endblock %}

{% block nowo_ui_form_aside %}
    {% if answer|default(null) %}
        {% set _b = page.bundle %}
        <aside class="nowo-wiki-ai">
            <section class="{{ nowo_ui_class('card', _b) }} nowo-wiki-ai__answer" data-testid="wiki-ai-answer"{{ nowo_ui_attrs('card', _b) }}>
                <header class="{{ nowo_ui_class('card_header', _b) }}">
                    <h2 class="{{ nowo_ui_class('card_title', _b) }} nowo-wiki-region-title">{{ 'wiki.ai.answer_title'|trans }}</h2>
                    <p class="{{ nowo_ui_class('card_intro', _b) }}">{{ question }}</p>
                </header>
                <div class="{{ nowo_ui_class('card_body', _b) }} nowo-wiki-ai__text">{{ answer|nl2br }}</div>
            </section>
            {% if sources|default([]) is not empty %}
                <section class="{{ nowo_ui_class('card', _b) }} nowo-wiki-ai__sources"{{ nowo_ui_attrs('card', _b) }}>
                    <header class="{{ nowo_ui_class('card_header', _b) }}">
                        <h2 class="{{ nowo_ui_class('card_title', _b) }} nowo-wiki-region-title">{{ 'wiki.ai.sources_title'|trans }}</h2>
                    </header>
                    <ul class="{{ nowo_ui_class('card_body', _b) }} nowo-wiki-sources">
                        {% for hit in sources %}
                            <li class="nowo-wiki-sources__item">
                                <a href="{{ hit.href }}" class="nowo-wiki-link">{{ hit.title }}</a>
                                <span class="{{ nowo_ui_class('muted', _b) }}">{{ hit.space }}</span>
                                <p class="{{ nowo_ui_class('muted', _b) }}">{{ hit.excerpt }}</p>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
        </aside>
    {% endif %}
{% endblock %}
