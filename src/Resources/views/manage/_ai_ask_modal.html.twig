{# Tabler/Bootstrap modal: initial AI question (POST → full answer page). Override this partial to use the host's dialog. #}
<div class="modal modal-blur fade nowo-wiki-ai-modal" id="wikiAiAskModal" tabindex="-1" aria-labelledby="wikiAiAskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered nowo-wiki-ai-modal__dialog" role="document">
        <div class="modal-content nowo-wiki-ai-modal__content">
            <div class="modal-header nowo-wiki-ai-modal__header">
                <div class="d-flex align-items-center gap-2 nowo-wiki-ai-modal__heading">
                    <span class="avatar bg-azure-lt nowo-wiki-avatar nowo-wiki-avatar--ai"><i class="ti ti-sparkles nowo-wiki-icon" aria-hidden="true"></i></span>
                    <div>
                        <h2 class="modal-title mb-0 nowo-wiki-ai-modal__title" id="wikiAiAskModalLabel">{{ 'wiki.ai.highlight_title'|trans({}, 'NowoWikiBundle') }}</h2>
                        <p class="text-secondary small mb-0 nowo-wiki-muted">{{ 'wiki.ai.highlight_intro'|trans({}, 'NowoWikiBundle') }}</p>
                    </div>
                </div>
                <button type="button" class="btn-close nowo-wiki-ai-modal__close" data-bs-dismiss="modal" aria-label="{{ 'wiki.action.cancel'|trans({}, 'NowoWikiBundle') }}"></button>
            </div>
            {# REQ-TWIG-005: WikiAiAskType (flat space / q / _token, token id wiki_ai_ask); the controller passes ai_form. #}
            {{ form_start(ai_form, {attr: {class: 'nowo-wiki-form nowo-wiki-ai-modal__form'}}) }}
                <div class="modal-body nowo-wiki-ai-modal__body">
                    <div class="row g-3 nowo-wiki-form__row">
                        <div class="col-md-5 nowo-wiki-form__field nowo-wiki-form__field--space">
                            {{ form_label(ai_form.space) }}
                            {{ form_widget(ai_form.space) }}
                        </div>
                        <div class="col-md-7 nowo-wiki-form__field nowo-wiki-form__field--query">
                            {{ form_label(ai_form.q) }}
                            {{ form_widget(ai_form.q) }}
                        </div>
                    </div>
                    {% for child in ai_form %}
                        {% if not child.rendered %}
                            {{ form_row(child) }}
                        {% endif %}
                    {% endfor %}
                    <p class="text-secondary small mt-3 mb-0 nowo-wiki-form__help">{{ 'wiki.ai.help'|trans({}, 'NowoWikiBundle') }}</p>
                </div>
                <div class="modal-footer nowo-wiki-ai-modal__footer nowo-wiki-actions">
                    <button type="button" class="btn btn-outline-secondary nowo-wiki-btn nowo-wiki-btn--secondary" data-bs-dismiss="modal">{{ 'wiki.action.cancel'|trans({}, 'NowoWikiBundle') }}</button>
                    <button type="submit" class="btn btn-azure nowo-wiki-btn nowo-wiki-btn--ai">
                        <i class="ti ti-sparkles me-1 nowo-wiki-icon" aria-hidden="true"></i>{{ 'wiki.ai.submit'|trans({}, 'NowoWikiBundle') }}
                    </button>
                </div>
            {{ form_end(ai_form) }}
        </div>
    </div>
</div>
