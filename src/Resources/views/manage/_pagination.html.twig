{#
    Previous / next pager (REQ-PERF-001).
    Variables: route (route name), route_params (hash), page (current, 1-based), has_previous, has_next, pages (optional total).
#}
{% if has_previous or has_next %}
    <nav class="d-flex align-items-center justify-content-between gap-2 mt-3 wiki-pagination" aria-label="{{ 'wiki.pagination.label'|trans({}, 'NowoWikiBundle') }}">
        {% if has_previous %}
            <a href="{{ path(route, route_params|merge({page: page - 1})) }}" class="btn btn-outline-secondary" rel="prev">
                <i class="ti ti-chevron-left me-1" aria-hidden="true"></i>{{ 'wiki.pagination.previous'|trans({}, 'NowoWikiBundle') }}
            </a>
        {% else %}
            <span></span>
        {% endif %}
        {% if pages is defined and pages is not null %}
            <span class="text-secondary">{{ 'wiki.pagination.page_of'|trans({'%page%': page, '%pages%': pages}, 'NowoWikiBundle') }}</span>
        {% endif %}
        {% if has_next %}
            <a href="{{ path(route, route_params|merge({page: page + 1})) }}" class="btn btn-outline-secondary" rel="next">
                {{ 'wiki.pagination.next'|trans({}, 'NowoWikiBundle') }}<i class="ti ti-chevron-right ms-1" aria-hidden="true"></i>
            </a>
        {% else %}
            <span></span>
        {% endif %}
    </nav>
{% endif %}
