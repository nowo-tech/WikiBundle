{# Wiki page header (title, subtitle, search / AI / dashboard actions) + flashes. Pages wrap this include in a `wiki_header` block. #}
<header class="page-header d-print-none mb-4 nowo-wiki-header">
    <div class="row align-items-center nowo-wiki-header__row">
        <div class="col nowo-wiki-header__text">
            {% if wiki_home_link|default(true) %}
                <div class="text-secondary small mb-1 nowo-wiki-header__breadcrumb">
                    <a href="{{ path(routes.index.name) }}" class="text-reset nowo-wiki-header__home">{{ 'wiki.title'|trans({}, 'NowoWikiBundle') }}</a>
                </div>
            {% endif %}
            <h1 class="page-title nowo-wiki-header__title">{{ page_title }}</h1>
            {% if page_subtitle|default(null) %}
                <p class="text-secondary mb-0 nowo-wiki-header__subtitle">{{ page_subtitle }}</p>
            {% endif %}
        </div>
        <div class="col-auto d-flex flex-wrap gap-2 nowo-wiki-header__actions nowo-wiki-actions">
            {% if show_search|default(false) %}
                <a href="{{ path(routes.search.name) }}" class="btn btn-primary nowo-wiki-btn nowo-wiki-btn--primary">
                    <i class="ti ti-search me-1 nowo-wiki-icon" aria-hidden="true"></i>{{ 'wiki.search.title'|trans({}, 'NowoWikiBundle') }}
                </a>
            {% endif %}
            {% if show_ai|default(false) and routes.ai_ask is defined %}
                {% if wiki_ai_modal|default(false) %}
                    <button type="button" class="btn btn-azure nowo-wiki-btn nowo-wiki-btn--ai" data-bs-toggle="modal" data-bs-target="#wikiAiAskModal">
                        <i class="ti ti-sparkles me-1 nowo-wiki-icon" aria-hidden="true"></i>{{ 'wiki.ai.title'|trans({}, 'NowoWikiBundle') }}
                    </button>
                {% else %}
                    <a href="{{ path(routes.ai_ask.name) }}" class="btn btn-azure nowo-wiki-btn nowo-wiki-btn--ai">
                        <i class="ti ti-sparkles me-1 nowo-wiki-icon" aria-hidden="true"></i>{{ 'wiki.ai.title'|trans({}, 'NowoWikiBundle') }}
                    </a>
                {% endif %}
            {% endif %}
            {% if dashboard_route %}
                <a href="{{ path(dashboard_route) }}" class="btn btn-outline-secondary nowo-wiki-btn nowo-wiki-btn--secondary">{{ 'wiki.back_dashboard'|trans({}, 'NowoWikiBundle') }}</a>
            {% endif %}
        </div>
    </div>
</header>
{{ include('@NowoWikiBundle/manage/_flashes.html.twig') }}
