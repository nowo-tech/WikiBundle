{% extends '@NowoWikiBundle/base.html.twig' %}

{% block title %}{{ page.title }}{% endblock %}

{% block body %}
    {{ include('@NowoWikiBundle/manage/_flashes.html.twig') }}
    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card" data-wiki-sidebar>
                <div class="card-header">
                    <a href="{{ path(routes.space.name, {spaceSlug: space.slug}) }}" class="text-reset">
                        <i class="ti ti-arrow-left me-1" aria-hidden="true"></i>{{ space.name }}
                    </a>
                </div>
                <div class="card-body py-2">
                    <nav aria-label="{{ 'wiki.space.pages'|trans({}, 'NowoWikiBundle') }}">
                        {{ include('@NowoWikiBundle/manage/_page_tree.html.twig', {tree: tree|default([]), space: space, routes: routes, tree_truncated: tree_truncated|default(false), max_tree_pages: max_tree_pages|default(null)}, false) }}
                    </nav>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <h2 class="card-title mb-0">{{ page.title }}</h2>
                    <div class="btn-list">
                        {% if can_edit %}
                            <a href="{{ path(routes.page_edit.name, {spaceSlug: space.slug, pageSlug: page.slug}) }}" class="btn btn-sm btn-outline-primary">
                                <i class="ti ti-pencil me-1" aria-hidden="true"></i>{{ 'wiki.page.edit'|trans({}, 'NowoWikiBundle') }}
                            </a>
                        {% endif %}
                        {% if can_history %}
                            <a href="{{ path(routes.page_history.name, {spaceSlug: space.slug, pageSlug: page.slug}) }}" class="btn btn-sm btn-outline-secondary">
                                <i class="ti ti-history me-1" aria-hidden="true"></i>{{ 'wiki.page.history'|trans({}, 'NowoWikiBundle') }}
                            </a>
                        {% endif %}
                    </div>
                </div>
                <div class="card-body wiki-page-content">
                    {{ revision ? revision.contentHtml|nowo_wiki_safe_html : '' }}
                </div>
            </div>
            {% block page_aside %}
                {% if used_in|default([]) is not empty %}
                    <section class="card mt-3 nowo-wiki-used-in" aria-labelledby="nowo-wiki-used-in-title">
                        <div class="card-header">
                            <h3 class="card-title mb-0" id="nowo-wiki-used-in-title">{{ 'wiki.page.used_in'|trans({}, 'NowoWikiBundle') }}</h3>
                        </div>
                        <ul class="list-group list-group-flush">
                            {% for objects in used_in %}
                                {% for object in objects %}
                                    <li class="list-group-item nowo-wiki-used-in__item" data-object-type="{{ object.type }}">
                                        <a href="{{ object.url }}">{{ object.label }}</a>
                                        {% if object.badge %}<span class="badge nowo-wiki-used-in__badge">{{ object.badge }}</span>{% endif %}
                                    </li>
                                {% endfor %}
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}
            {% endblock %}
        </div>
    </div>
{% endblock %}
