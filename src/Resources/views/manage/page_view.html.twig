{#
  Page view (REQ-UI-003): UiKit show scaffold. Variable: page (View\ShowPage from WikiPageFactory::pageView(): header =
  page title / space name with Edit, History and Archive (POST + CSRF behind a UiKit confirm dialog), breadcrumbs
  Wiki > space > page; meta = revision number and date).
  Also (value-free): tree, tree_truncated, max_tree_pages, tree_search_href, content_html (current revision body,
  printed through nowo_wiki_safe_html), used_in (WikiPageFactory::usedIn(): {type, label, href, badge}).
  Blocks filled: nowo_ui_styles, nowo_ui_scripts (parent() + wiki.js: scrolls the current page of the tree into view), nowo_ui_show_sections (sidebar tree + content + "Used in").
#}
{% extends '@NowoUiKit/page/show.html.twig' %}
{% trans_default_domain 'NowoWikiBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('wiki.css', 'nowo_wiki') }}">
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {% set _nonce = app.request ? app.request.attributes.get('csp_nonce') : null %}
    <script src="{{ asset('wiki.js', 'nowo_wiki') }}" defer{% if _nonce %} nonce="{{ _nonce }}"{% endif %}></script>
{% endblock %}

{% block nowo_ui_show_sections %}
    {% set _b = page.bundle %}
    <div class="nowo-wiki-layout">
        <div class="nowo-wiki-layout__aside">
            {{ include('@NowoWikiBundle/manage/_sidebar.html.twig', {tree: tree, tree_truncated: tree_truncated|default(false), max_tree_pages: max_tree_pages|default(0), tree_search_href: tree_search_href|default(null), bundle: _b}, false) }}
        </div>
        <div class="nowo-wiki-layout__main">
            <article class="{{ nowo_ui_class('card', _b) }} nowo-wiki-page"{{ nowo_ui_attrs('card', _b) }}>
                <div class="{{ nowo_ui_class('card_body', _b) }} nowo-wiki-content" data-testid="wiki-content">
                    {{ content_html|default('')|nowo_wiki_safe_html }}
                </div>
            </article>
            {% if used_in|default([]) is not empty %}
                <section class="{{ nowo_ui_class('card', _b) }} nowo-wiki-used-in" aria-labelledby="nowo-wiki-used-in-title"{{ nowo_ui_attrs('card', _b) }}>
                    <header class="{{ nowo_ui_class('card_header', _b) }}">
                        <h2 class="{{ nowo_ui_class('card_title', _b) }} nowo-wiki-region-title" id="nowo-wiki-used-in-title">{{ 'wiki.page.used_in'|trans }}</h2>
                    </header>
                    <ul class="{{ nowo_ui_class('card_body', _b) }} nowo-wiki-used-in__list">
                        {% for object in used_in %}
                            <li class="nowo-wiki-used-in__item" data-object-type="{{ object.type }}">
                                <a href="{{ object.href }}" class="nowo-wiki-used-in__link">{{ object.label }}</a>
                                {% if object.badge %}<span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ object.badge }}</span>{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
        </div>
    </div>
{% endblock %}
