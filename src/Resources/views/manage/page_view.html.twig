{#
  Page view (REQ-UI-003): UiKit show scaffold. Variable: page (View\ShowPage from WikiPageFactory::pageView(): header =
  page title / space name with Save version, Move, Delete and Archive (POST + CSRF behind a UiKit confirm dialog; 1.25: Edit and History are only tabs), breadcrumbs
  Wiki > space > page; meta = revision number and date).
  Also (value-free): tree, tree_truncated, max_tree_pages, tree_search_href, tree_ui (1.14, null without tree.enabled;
  adds js/nowo-ui-tree.js; the header gets Move), copy_markdown (1.15, editors with editor.milkdown.copy_markdown: the
  source for the "Copy as Markdown" button), content_html (current revision body,
  printed through nowo_wiki_safe_html), used_in (WikiPageFactory::usedIn(): {type, label, href, badge}), page_files
  (1.20, page_files.enabled: list of PageFile\WikiPageFile {url, name, kind, size, type} the current revision refers
  to, shown as the "Files" card; URLs are relative or http(s) only), rich_content
  (1.13, editor.type milkdown: the body is rendered for the viewer and wiki.js draws its Mermaid / math with the
  Milkdown read-side script of nowo_wiki_rich_content_assets()).
  1.16: page.header.tabs (View\AreaNav: Page / Edit / History) renders as the tab row under the header
  (_page_tabs.html.twig), always; comments (WikiCommentsPanel::panel(), only with comments.enabled and
  WikiAction::ViewComments) adds the comments toggle at the end of that row and the comments side panel
  (_comments_panel.html.twig) right of the content; comments_view ({markdown, options}) mounts the page read-only with
  nowo_milkdown_view() for the Milkdown thread component (hidden until the editor is ready; the server-rendered body
  stays the no-JavaScript view).
  1.21: blocks wiki_page_header_extra (after the header, before the tab row; empty by default) and wiki_sidebar (the
  tree card) for templates that extend this one, filled by the web_ui.slots.page_header_extra / sidebar templates when
  set (included with the page variables); web_ui.assets.styles / scripts: false leave nowo_ui_styles /
  nowo_ui_scripts empty.
  Blocks filled: nowo_ui_styles, nowo_ui_scripts (parent() + the rich-content assets + wiki.js: scrolls the current page of the tree into view, draws rich content; 1.16 + nowo-ui-side-panel.js with comments), nowo_ui_page_header (the UiKit header without its tabs + the tab row), nowo_ui_content (1.16: inside the side panel container with comments), nowo_ui_show_sections (sidebar tree + content + "Used in").
#}
{% extends '@NowoUiKit/page/show.html.twig' %}
{% trans_default_domain 'NowoWikiBundle' %}

{% block nowo_ui_styles %}
    {#- 1.21 web_ui.assets.styles: false = the host bundles the assets (nothing printed here) -#}
    {% if nowo_wiki_web_ui.assets.styles ?? true %}
        {{ parent() }}
        <link rel="stylesheet" href="{{ asset('wiki.css', 'nowo_wiki') }}">
    {% endif %}
{% endblock %}

{% block nowo_ui_scripts %}
    {#- 1.21 web_ui.assets.scripts: false = the host bundles the assets (nothing printed here) -#}
    {% if nowo_wiki_web_ui.assets.scripts ?? true %}
        {{ parent() }}
        {% set _nonce = app.request ? app.request.attributes.get('csp_nonce') : null %}
        {% if rich_content|default(false) %}{{ nowo_wiki_rich_content_assets() }}{% endif %}
        {% if tree_ui|default(null) %}<script src="{{ asset('js/nowo-ui-tree.js', 'nowo_ui_kit') }}" defer{% if _nonce %} nonce="{{ _nonce }}"{% endif %}></script>{% endif %}
        {% if comments|default(null) %}<script src="{{ asset('js/nowo-ui-side-panel.js', 'nowo_ui_kit') }}" defer{% if _nonce %} nonce="{{ _nonce }}"{% endif %}></script>{% endif %}
        <script src="{{ asset('wiki.js', 'nowo_wiki') }}" data-code-label="{{ 'wiki.code_block'|trans }}" defer{% if _nonce %} nonce="{{ _nonce }}"{% endif %}></script>
    {% endif %}
{% endblock %}

{% block nowo_ui_page_header %}
    {{ include('@NowoUiKitBundle/page/_page_header.html.twig', {header: page.header.withTabs(null), bundle: page.bundle, nowo_ui_page_type: 'show', extra_actions: [], header_actions: true}, false) }}
    {#- 1.21: after the header, before the tab row (web_ui.slots.page_header_extra, else nothing) -#}
    {% block wiki_page_header_extra %}{% if nowo_wiki_web_ui.slots.page_header_extra ?? null %}{{ include(nowo_wiki_web_ui.slots.page_header_extra) }}{% endif %}{% endblock %}
    {% if page.header.tabs %}{{ include('@NowoWikiBundle/manage/_page_tabs.html.twig', {tabs: page.header.tabs, comments: comments|default(null), bundle: page.bundle}, false) }}{% endif %}
{% endblock %}

{% block nowo_ui_content %}
    {% if comments|default(null) %}
        {% set _wiki_content %}{{ parent() }}{% endset %}
        {% embed nowo_ui_partial('side_panel_container', page.bundle) with {bundle: page.bundle, attr: {'data-testid': 'wiki-comments-layout'}} %}
            {% block nowo_ui_side_panel_main %}{{ _wiki_content }}{% endblock %}
            {% block nowo_ui_side_panel_panel %}{{ include('@NowoWikiBundle/manage/_comments_panel.html.twig', {comments: comments, bundle: bundle}, false) }}{% endblock %}
        {% endembed %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block nowo_ui_show_sections %}
    {% set _b = page.bundle %}
    <div class="nowo-wiki-layout">
        <div class="nowo-wiki-layout__aside">
            {% block wiki_sidebar %}
                {%- if nowo_wiki_web_ui.slots.sidebar ?? null -%}
                    {{ include(nowo_wiki_web_ui.slots.sidebar) }}
                {%- else -%}
                    {{ include('@NowoWikiBundle/manage/_sidebar.html.twig', {tree: tree, tree_truncated: tree_truncated|default(false), max_tree_pages: max_tree_pages|default(0), tree_search_href: tree_search_href|default(null), tree_ui: tree_ui|default(null), bundle: _b}, false) }}
                {%- endif -%}
            {% endblock %}
        </div>
        <div class="nowo-wiki-layout__main">
            {# 1.15: editors only; a separate template so pages without Milkdown 1.5 never compile the function #}
            {% if copy_markdown|default(null) %}{{ include('@NowoWikiBundle/manage/_copy_markdown.html.twig', {source: copy_markdown, bundle: _b}, false) }}{% endif %}
            {# 1.16: commenters get the page as a read-only editor (highlights, the thread component); hidden until it is ready #}
            {% if comments_view|default(null) %}
                {{ include('@NowoWikiBundle/manage/_comments_view.html.twig', {comments_view: comments_view}, false) }}
            {% endif %}
            <article class="{{ nowo_ui_class('card', _b) }} nowo-wiki-page"{% if comments_view|default(null) %} data-nowo-wiki-server-body{% endif %}{{ nowo_ui_attrs('card', _b) }}>
                <div class="{{ nowo_ui_class('card_body', _b) }} nowo-wiki-content{% if rich_content|default(false) %} nowo-md{% endif %}" data-testid="wiki-content"{% if rich_content|default(false) %} data-wiki-rich-content{% endif %}>
                    {{ content_html|default('')|nowo_wiki_safe_html }}
                </div>
            </article>
            {% if used_in|default([]) is not empty %}
                <section class="{{ nowo_ui_class('card', _b) }} nowo-wiki-used-in" aria-labelledby="nowo-wiki-used-in-title"{{ nowo_ui_attrs('card', _b) }}>
                    <header class="{{ nowo_ui_class('card_header', _b) }}">
                        <h2 class="{{ nowo_ui_class('card_title', _b) }} nowo-wiki-region-title" id="nowo-wiki-used-in-title">{{ 'wiki.page.used_in'|trans }}</h2>
                    </header>
                    <ul class="{{ nowo_ui_class('card_body', _b) }} nowo-wiki-used-in__list">
                        {% for object in used_in %}
                            <li class="nowo-wiki-used-in__item" data-object-type="{{ object.type }}">
                                <a href="{{ object.href }}" class="nowo-wiki-used-in__link">{{ object.label }}</a>
                                {% if object.badge %}<span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ object.badge }}</span>{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
            {% if page_files|default([]) is not empty %}
                <section class="{{ nowo_ui_class('card', _b) }} nowo-wiki-files" aria-labelledby="nowo-wiki-files-title" data-testid="wiki-page-files"{{ nowo_ui_attrs('card', _b) }}>
                    <header class="{{ nowo_ui_class('card_header', _b) }}">
                        <h2 class="{{ nowo_ui_class('card_title', _b) }} nowo-wiki-region-title" id="nowo-wiki-files-title">{{ 'wiki.page.files'|trans }}</h2>
                    </header>
                    <ul class="{{ nowo_ui_class('card_body', _b) }} nowo-wiki-used-in__list nowo-wiki-files__list">
                        {% for file in page_files %}
                            <li class="nowo-wiki-used-in__item nowo-wiki-files__item" data-kind="{{ file.kind }}">
                                <a href="{{ file.url }}" class="nowo-wiki-files__link" rel="noopener noreferrer">{{ file.name is not empty ? file.name : file.url }}</a>
                                <span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ (file.kind == 'image' ? 'wiki.page.file_image' : 'wiki.page.file')|trans }}{% if file.sizeLabel %} · {{ file.sizeLabel }}{% endif %}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
        </div>
    </div>
{% endblock %}
