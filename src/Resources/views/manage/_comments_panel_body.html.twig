{#
  Body of the comments panel (1.16). With comments.mounted (the edit view, editors on the read view, or
  comments.read_view_source) the Milkdown 1.6 thread component (inline and page-level threads) mounts into
  [data-nowo-wiki-comments-mount] (panel: container) and wiki.js hides the fallback below once the editor is ready.
  Without it (commenters who may not edit, by default) the server list below is the panel: every open thread, inline
  ones with their quote as text and a muted "Reply from the editor" line (a link to page_edit?comments=1 when
  comments.edit_href is set, i.e. the viewer may edit), and the comment form; the page source is never sent.
  Without JavaScript: the open page-level threads (comment bodies rendered per viewer by the safe renderer and printed
  through nowo_wiki_safe_html) and, for commenters, the WikiCommentType form posting to …/comments/new; inline threads
  need the editor. Authors follow the history name policy; a picture only beside a real name (UiKit `_avatar`).
  1.21 (each off by default): comments.error_notices adds the notice of refused writes (422 limit_reached / 429
  rate limit; a UiKit toast when the toast script is loaded, from the <template>s below, else the polite live region);
  comments.moderation (comments.moderation_panel and WikiAction::ModerateComments) adds *Moderate threads*: every
  thread of the page with *Delete thread* behind a confirm dialog (wiki.js, wiki-comments-moderation.ts).
  1.31 (comments.thread_list: uikit; default plain = the 1.30 mount): the mount carries data-nowo-wiki-thread-list: the UiKit classes (list / list_item macros, badge_neutral, check,
  check_input) and the translated labels wiki.js (wiki-comments-list.ts) gives the thread component's list — rows,
  a badge with the plural count of each thread (wiki.comments.list.count_*, CLDR plural category of the locale) and a
  UiKit checkbox for "Show resolved"; a thread without a title reads wiki.comments.list.thread.
  Variables: comments (WikiCommentsPanel::panel()), bundle.
#}
{% trans_default_domain 'NowoWikiBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as _ui %}
{% set _b = bundle|default(null) %}
{% if comments.mounted is not defined or comments.mounted %}
    {% set _thread_list = comments.thread_list|default('plain') != 'uikit' ? null : {
        list: _ui.list()|trim,
        item: _ui.list_item()|trim,
        badge: nowo_ui_class('badge_neutral', _b),
        check: nowo_ui_class('check', _b),
        check_input: nowo_ui_class('check_input', _b),
        open_label: 'comments.open'|trans({}, 'NowoMilkdownEditorBundle'),
        thread_label: 'wiki.comments.list.thread'|trans,
        count: {
            one: 'wiki.comments.list.count_one'|trans,
            many: 'wiki.comments.list.count_many'|trans,
            other: 'wiki.comments.list.count_other'|trans,
        },
    } %}
    <div class="nowo-wiki-comments__mount" data-nowo-wiki-comments-mount{% if _thread_list %} data-nowo-wiki-thread-list="{{ _thread_list|json_encode }}"{% endif %} data-testid="wiki-comments-mount"></div>
{% endif %}
<div class="nowo-wiki-comments__fallback"{% if comments.mounted is not defined or comments.mounted %} data-nowo-wiki-comments-fallback{% endif %} data-testid="wiki-comments-fallback">
    {% if comments.page_threads is empty %}
        <p class="nowo-wiki-comments__empty">{{ 'wiki.comments.empty'|trans }}</p>
    {% else %}
        <ul class="nowo-wiki-comments__list">
            {% for thread in comments.page_threads %}
                <li class="nowo-wiki-comments__thread" data-thread-id="{{ thread.id }}">
                    {% if thread.anchor|default(null) %}
                        {#- only the quote, and blank once the text left the page (audit EI-L7) -#}
                        {% if thread.anchor.quote.exact != '' %}<blockquote class="nowo-wiki-comment__quote" data-testid="wiki-comment-quote">{{ thread.anchor.quote.exact }}</blockquote>{% else %}<p class="{{ nowo_ui_class('muted', _b) }} nowo-wiki-comment__quote-gone" data-testid="wiki-comment-quote-gone">{{ 'wiki.comments.quote_gone'|trans }}</p>{% endif %}
                        {#- inline threads are answered in the editor (no highlight here): a link for editors, else a hint -#}
                        <p class="{{ nowo_ui_class('muted', _b) }} nowo-wiki-comment__reply-hint" data-testid="wiki-comment-reply-hint">
                            {%- if comments.edit_href|default(null) -%}
                                <a href="{{ comments.edit_href }}">{{ 'wiki.comments.reply_in_editor'|trans }}</a>
                            {%- else -%}
                                {{ 'wiki.comments.reply_in_editor'|trans }}
                            {%- endif -%}
                        </p>
                    {% endif %}
                    {% for comment in thread.comments %}
                        <article class="nowo-wiki-comment" aria-label="{{ 'wiki.comments.by'|trans({'%name%': comment.author.name}) }}">
                            <header class="nowo-wiki-comment__header">
                                {% if comment.author.avatarUrl %}{{ include('@NowoUiKitBundle/partials/_avatar.html.twig', {name: comment.author.name, src: comment.author.avatarUrl, size: 'sm', decorative: true}, false) }}{% endif %}
                                <span class="nowo-wiki-comment__author">{{ comment.author.name }}</span>
                                <time class="nowo-wiki-comment__time" datetime="{{ comment.createdAt }}">{{ comment.createdAt|date('Y-m-d H:i') }}</time>
                            </header>
                            {% if comment.deleted|default(false) %}
                                <p class="nowo-wiki-comment__deleted">{{ 'wiki.comments.deleted'|trans }}</p>
                            {% else %}
                                <div class="nowo-wiki-comment__body nowo-md">{{ comment.html|nowo_wiki_safe_html }}</div>
                            {% endif %}
                        </article>
                        {#- 1.16.1 (audit EI-I18 / EI2-I6): the opening comment, then the latest ones -#}
                        {% if loop.first and thread.more|default(0) > 0 %}<p class="{{ nowo_ui_class('muted', _b) }} nowo-wiki-comment__more" data-testid="wiki-comment-more">{{ 'wiki.comments.more_in_editor'|trans({'%count%': thread.more}) }}</p>{% endif %}
                    {% endfor %}
                </li>
            {% endfor %}
        </ul>
        {% if comments.truncated|default(false) %}<p class="{{ nowo_ui_class('muted', _b) }}" data-testid="wiki-comments-truncated">{{ 'wiki.comments.truncated'|trans({'%count%': comments.page_threads|length}) }}</p>{% endif %}
    {% endif %}
    {% if comments.form|default(null) %}
        {{ form_start(comments.form, {attr: {class: 'nowo-wiki-comments__form', 'data-testid': 'wiki-comments-fallback-form'}}) }}
            {{ form_row(comments.form.body) }}
            <button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }}">{{ 'wiki.comments.send'|trans }}</button>
        {{ form_end(comments.form) }}
    {% endif %}
</div>
{% if comments.error_notices|default(false) %}
    <p class="{{ nowo_ui_class('muted', _b) }} nowo-wiki-comments__notice" data-nowo-wiki-comments-notice role="status" aria-live="polite" hidden
       data-limit-reached="{{ 'wiki.comments.error.limit_reached'|trans }}"
       data-rate-limited="{{ 'wiki.comments.error.rate_limited'|trans }}"
       data-testid="wiki-comments-notice"></p>
    {% for _tone in ['error', 'success'] %}
        <template data-nowo-wiki-comments-toast="{{ _tone }}">{{ include(nowo_ui_partial('toasts', _b), {flashes: {(_tone): ['-']}, bundle: _b}, false) }}</template>
    {% endfor %}
{% endif %}
{% if comments.moderation|default(false) %}
    <details class="nowo-wiki-moderation" data-nowo-wiki-moderation data-testid="wiki-comments-moderation"
             data-url="{{ comments.comments_url }}"
             data-token="{{ comments.csrf_token }}"
             data-button-class="{{ nowo_ui_class('btn_secondary', _b) }}"
             data-labels="{{ {
                 page_comment: 'wiki.comments.moderation.page_comment'|trans,
                 resolved: 'wiki.comments.moderation.resolved'|trans,
                 count: 'wiki.comments.moderation.count'|trans,
                 delete: 'wiki.comments.moderation.delete'|trans,
                 deleted: 'wiki.comments.moderation.deleted'|trans,
                 failed: 'wiki.comments.moderation.failed'|trans,
                 empty: 'wiki.comments.moderation.empty'|trans,
                 rate_limited: 'wiki.comments.error.rate_limited'|trans,
                 confirm: 'wiki.comments.moderation.confirm'|trans,
             }|json_encode }}">
        <summary class="nowo-wiki-moderation__summary">{{ 'wiki.comments.moderation.title'|trans }}</summary>
        <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'wiki.comments.moderation.help'|trans }}</p>
        <p class="{{ nowo_ui_class('muted', _b) }}" data-nowo-wiki-moderation-status aria-live="polite"></p>
        <ul class="nowo-wiki-moderation__list" data-nowo-wiki-moderation-list data-testid="wiki-comments-moderation-list"></ul>
        <dialog class="nowo-wiki-moderation__confirm" data-nowo-wiki-moderation-confirm aria-labelledby="nowo-wiki-moderation-confirm-title" data-testid="wiki-comments-moderation-confirm">
            <p class="nowo-wiki-region-title" id="nowo-wiki-moderation-confirm-title">{{ 'wiki.comments.moderation.confirm_title'|trans }}</p>
            <p>{{ 'wiki.comments.moderation.confirm'|trans }}</p>
            <p class="{{ nowo_ui_class('form_actions', _b) }}">
                <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-nowo-wiki-moderation-cancel>{{ 'wiki.action.cancel'|trans }}</button>
                <button type="button" class="{{ nowo_ui_class('btn_danger', _b) }}" data-nowo-wiki-moderation-accept data-testid="wiki-comments-moderation-accept">{{ 'wiki.comments.moderation.delete'|trans }}</button>
            </p>
        </dialog>
    </details>
{% endif %}
