{#
  AI question dialog of the wiki index: the UiKit `dialog` theme partial (native <dialog>, opened by the page-header
  action through data-nowo-ui-dialog-open, closed by Escape / the close button / Cancel). 1.18 (UiKit 2.29 dialog
  sizes): the medium size (a short form: space + question): the width is the platform's (--nowo-dialog-width-md); the
  height is UiKit's (1.19, dialog rule v2: from UiKit 2.31 the content's, capped at --nowo-dialog-height-md; the
  bundle sets none); the body is the only part that scrolls and
  the footer stays outside it, with Cancel then the one primary (Ask) bound to the form by form="…". The question
  field has autofocus, so showModal() focuses it. Variables: ai_form (WikiAiAskType view, POST to the ai_ask route),
  bundle.
#}
{% set _form_id = 'nowo-wiki-ai-dialog-form' %}
{% set _footer %}
    <button type="button" class="{{ nowo_ui_class('btn_secondary', bundle) }}" data-nowo-ui-dialog-close>{{ 'wiki.action.cancel'|trans({}, 'NowoWikiBundle') }}</button>
    <button type="submit" class="{{ nowo_ui_class('btn_primary', bundle) }}" form="{{ _form_id }}" data-testid="wiki-ai-submit">{{ 'wiki.ai.submit'|trans({}, 'NowoWikiBundle') }}</button>
{% endset %}
{% set _body %}
    <p class="{{ nowo_ui_class('muted', bundle) }}">{{ 'wiki.ai.highlight_intro'|trans({}, 'NowoWikiBundle') }}</p>
    {{ form_start(ai_form, {attr: {id: _form_id, class: nowo_ui_class('form', bundle)}}) }}
        {% for child in ai_form %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    {{ form_end(ai_form) }}
    <p class="{{ nowo_ui_class('muted', bundle) }}">{{ 'wiki.ai.help'|trans({}, 'NowoWikiBundle') }}</p>
{% endset %}
{{ include(nowo_ui_partial('dialog', bundle), {
    id: 'nowo-wiki-ai-dialog',
    title: 'wiki.ai.highlight_title'|trans({}, 'NowoWikiBundle'),
    size: 'md',
    body: _body,
    footer: _footer,
    bundle: bundle,
    nowo_ui_page_type: nowo_ui_page_type|default(null),
    attr: {'data-testid': 'wiki-ai-dialog'},
}, false) }}
