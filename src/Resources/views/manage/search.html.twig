{#
  Search (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from WikiPageFactory::search(): header
  wiki.search.title / intro (global results when no space was chosen), breadcrumbs; filters = the search form (GET
  space / q, bookmarks unchanged) with the Search button; columns title, space, excerpt; rows {id, title, space,
  excerpt, href} (hits the user may read only); row action Open; caption = the pluralised result count; EmptyState
  wiki.search.empty after a query, else wiki.search.help).
  Blocks filled: nowo_ui_styles, nowo_ui_list_row (the title links to the page).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoWikiBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('wiki.css', 'nowo_wiki') }}">
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _cell = nowo_ui_class('table_cell', page.bundle) %}
    <td class="{{ _cell }}" data-label="{{ 'wiki.search.result_title'|trans }}" data-required="1">
        <a href="{{ row.href }}" class="nowo-wiki-link nowo-wiki-results__title">{{ row.title }}</a>
    </td>
    <td class="{{ _cell }}" data-label="{{ 'wiki.search.result_space'|trans }}" data-nowo-ui-priority="2">
        <span class="{{ nowo_ui_class('badge_info', page.bundle) }}">{{ row.space }}</span>
    </td>
    <td class="{{ _cell }} nowo-wiki-results__excerpt" data-label="{{ 'wiki.search.result_excerpt'|trans }}" data-nowo-ui-priority="2">{{ row.excerpt }}</td>
{% endblock %}
