{#
  Wiki index (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from WikiPageFactory::index(): header
  wiki.index.title / intro with "Ask the wiki" (opens the AI dialog, when the AI is available) and "Back to dashboard"
  (dashboard_route); filters = the global search form (GET to the search route); columns name, slug; rows
  {id, name, slug, href}; row action Open; Pagination (pagination.spaces_per_page); EmptyState wiki.index.empty).
  Also: ai_form (WikiAiAskType view or null).
  Blocks filled: nowo_ui_styles (parent() + wiki.css), nowo_ui_list_row (the name
  links to the space), nowo_ui_modals (AI question dialog).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoWikiBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('wiki.css', 'nowo_wiki') }}">
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _cell = nowo_ui_class('table_cell', page.bundle) %}
    <td class="{{ _cell }}" data-label="{{ 'wiki.index.name'|trans }}" data-required="1">
        <a href="{{ row.href }}" class="nowo-wiki-link">{{ row.name }}</a>
    </td>
    <td class="{{ _cell }}" data-label="{{ 'wiki.index.slug'|trans }}" data-nowo-ui-priority="2">
        <code class="{{ nowo_ui_class('code', page.bundle) }}">{{ row.slug }}</code>
    </td>
{% endblock %}

{% block nowo_ui_modals %}
    {% if ai_form|default(null) %}
        {{ include('@NowoWikiBundle/manage/_ai_dialog.html.twig', {ai_form: ai_form, bundle: page.bundle}, false) }}
    {% endif %}
{% endblock %}
