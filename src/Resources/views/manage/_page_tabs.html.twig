{#
  Page tab row (1.16, B-Q1) of the read and edit views, under the page header: Page / Edit / History (View\AreaNav from
  WikiPageFactory::pageTabs(), rendered by the UiKit `tabs` theme partial at the secondary level; the current view
  has aria-current="page"), then — only with comments.enabled and WikiAction::ViewComments — the comments toggle at the
  end of the same row: the UiKit `side_panel_toggle` theme partial as an icon button (tabler:message-circle) whose
  visible count badge (open threads the viewer may read) is also part of its accessible name ("Comments 3 open";
  "Comments" alone at 0). Without JavaScript the toggle is a link to ?comments=1 (?comments=0 when open).
  Variables: tabs (View\AreaNav), comments (WikiCommentsPanel::panel() or null), bundle.
#}
{% trans_default_domain 'NowoWikiBundle' %}
{% set _b = bundle|default(null) %}
{% set _items = [] %}
{% for item in tabs.items %}
    {% set _items = _items|merge([{label: item.label, href: item.href, current: item.active, attr: item.attributes}]) %}
{% endfor %}
<div class="nowo-wiki-tabs" data-testid="wiki-tabs">
    {{ include(nowo_ui_partial('tabs', _b), {
        items: _items,
        aria_label: tabs.label is null ? null : (tabs.label.key is defined ? tabs.label.key|trans(tabs.label.params, tabs.label.domain) : tabs.label),
        level: 'secondary',
        bundle: _b,
    }, false) }}
    {% if comments|default(null) %}
        <div class="nowo-wiki-tabs__end">
            {{ include(nowo_ui_partial('side_panel_toggle', _b), {
                target: comments.id,
                label: 'wiki.comments.title'|trans,
                open: comments.open,
                href: comments.toggle_href,
                icon: 'tabler:message-circle',
                count: comments.count,
                count_suffix: 'wiki.comments.open_suffix'|trans,
                shortcut: comments.shortcut,
                attr: {'data-testid': 'wiki-comments-toggle', 'data-nowo-wiki-comments-toggle': true},
                bundle: _b,
            }, false) }}
        </div>
    {% endif %}
</div>
