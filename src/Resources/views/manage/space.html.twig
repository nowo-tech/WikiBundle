{#
  Space home (REQ-UI-003): UiKit show scaffold. Variable: page (View\ShowPage from WikiPageFactory::space(): header =
  space name / wiki.space.pick_page with New page and the Outline / Notion exports, breadcrumbs Wiki > space).
  Also (value-free): tree (WikiPageFactory::tree()), tree_truncated, max_tree_pages, tree_search_href, search_form
  (GET, space hidden), import_form (WikiImportType view or null when the user may not import), archived
  (WikiPageFactory::archived(): {title, action}).
  Blocks filled: nowo_ui_styles, nowo_ui_scripts (parent() + wiki.js: scrolls the current page of the tree into view), nowo_ui_show_sections (sidebar tree + search, import, archived
  pages). The bundle-specific regions use the UiKit theme slots (card, card_header, card_title, card_body,
  form, form_actions, btn_primary, muted).
#}
{% extends '@NowoUiKit/page/show.html.twig' %}
{% trans_default_domain 'NowoWikiBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('wiki.css', 'nowo_wiki') }}">
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {% set _nonce = app.request ? app.request.attributes.get('csp_nonce') : null %}
    <script src="{{ asset('wiki.js', 'nowo_wiki') }}" defer{% if _nonce %} nonce="{{ _nonce }}"{% endif %}></script>
{% endblock %}

{% block nowo_ui_show_sections %}
    {% set _b = page.bundle %}
    <div class="nowo-wiki-layout">
        <div class="nowo-wiki-layout__aside">
            {{ include('@NowoWikiBundle/manage/_sidebar.html.twig', {tree: tree, tree_truncated: tree_truncated|default(false), max_tree_pages: max_tree_pages|default(0), tree_search_href: tree_search_href|default(null), bundle: _b}, false) }}
        </div>
        <div class="nowo-wiki-layout__main">
            <section class="{{ nowo_ui_class('card', _b) }} nowo-wiki-search" data-testid="wiki-space-search"{{ nowo_ui_attrs('card', _b) }}>
                <div class="{{ nowo_ui_class('card_body', _b) }}">
                    {{ form_start(search_form, {attr: {class: nowo_ui_class('form', _b), role: 'search'}}) }}
                        {% for child in search_form %}
                            {% if not child.rendered %}
                                {{ form_row(child) }}
                            {% endif %}
                        {% endfor %}
                        <div class="{{ nowo_ui_class('form_actions', _b) }}">
                            <button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }}">{{ 'wiki.search.submit'|trans }}</button>
                        </div>
                    {{ form_end(search_form) }}
                </div>
            </section>

            {% if import_form|default(null) %}
                <section class="{{ nowo_ui_class('card', _b) }} nowo-wiki-import" data-testid="wiki-import"{{ nowo_ui_attrs('card', _b) }}>
                    <header class="{{ nowo_ui_class('card_header', _b) }}">
                        <h2 class="{{ nowo_ui_class('card_title', _b) }} nowo-wiki-region-title">{{ 'wiki.import_export.title'|trans }}</h2>
                        <p class="{{ nowo_ui_class('card_intro', _b) }}">{{ 'wiki.import.help'|trans }}</p>
                    </header>
                    <div class="{{ nowo_ui_class('card_body', _b) }}">
                        {{ form_start(import_form, {attr: {class: nowo_ui_class('form', _b)}}) }}
                            {% for child in import_form %}
                                {% if not child.rendered %}
                                    {{ form_row(child) }}
                                {% endif %}
                            {% endfor %}
                            <div class="{{ nowo_ui_class('form_actions', _b) }}">
                                <button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }}">{{ 'wiki.import.submit'|trans }}</button>
                            </div>
                        {{ form_end(import_form) }}
                    </div>
                </section>
            {% endif %}

            {% if archived|default([]) is not empty %}
                <section class="{{ nowo_ui_class('card', _b) }} nowo-wiki-archived" data-testid="wiki-archived"{{ nowo_ui_attrs('card', _b) }}>
                    <header class="{{ nowo_ui_class('card_header', _b) }}">
                        <h2 class="{{ nowo_ui_class('card_title', _b) }} nowo-wiki-region-title">{{ 'wiki.space.archived'|trans }}</h2>
                    </header>
                    <ul class="{{ nowo_ui_class('card_body', _b) }} nowo-wiki-archived__list">
                        {% for item in archived %}
                            <li class="nowo-wiki-archived__item">
                                <span class="nowo-wiki-archived__title">{{ item.title }}</span>
                                {% if item.action %}
                                    {{ include(nowo_ui_partial('action', _b), {action: item.action, context: 'row', bundle: _b, nowo_ui_page_type: nowo_ui_page_type}, false) }}
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
        </div>
    </div>
{% endblock %}
