{% extends '@NowoWikiBundle/base.html.twig' %}

{% block title %}{{ space.name }}{% endblock %}

{% block body %}
    {{ include('@NowoWikiBundle/manage/_page_header.html.twig', {
        page_title: space.name,
        page_subtitle: 'wiki.space.pick_page'|trans({}, 'NowoWikiBundle'),
        show_search: true,
    }) }}

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card" data-wiki-sidebar>
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h3 class="card-title mb-0">{{ 'wiki.space.pages'|trans({}, 'NowoWikiBundle') }}</h3>
                    {% if can_create %}
                        <a href="{{ path(routes.page_new.name, {spaceSlug: space.slug}) }}" class="btn btn-sm btn-primary">
                            <i class="ti ti-plus me-1" aria-hidden="true"></i>{{ 'wiki.space.new_page'|trans({}, 'NowoWikiBundle') }}
                        </a>
                    {% endif %}
                </div>
                <div class="card-body">
                    <nav aria-label="{{ 'wiki.space.pages'|trans({}, 'NowoWikiBundle') }}">
                        {{ include('@NowoWikiBundle/manage/_page_tree.html.twig', {tree: tree, space: space, routes: routes, tree_truncated: tree_truncated|default(false), max_tree_pages: max_tree_pages|default(null)}) }}
                    </nav>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-body">
                    <p class="text-secondary">{{ 'wiki.space.pick_page'|trans({}, 'NowoWikiBundle') }}</p>
                    {# REQ-TWIG-005: WikiSearchType (GET, flat space / q). #}
                    {{ form_start(search_form, {attr: {class: 'row g-2 align-items-end'}}) }}
                        <div class="col">
                            {{ form_label(search_form.q) }}
                            {{ form_widget(search_form.q) }}
                        </div>
                        {% for child in search_form %}
                            {% if not child.rendered %}
                                {{ form_row(child) }}
                            {% endif %}
                        {% endfor %}
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">{{ 'wiki.search.submit'|trans({}, 'NowoWikiBundle') }}</button>
                        </div>
                    {{ form_end(search_form) }}
                </div>
            </div>

            {% if can_export or can_import %}
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title mb-0">{{ 'wiki.import_export.title'|trans({}, 'NowoWikiBundle') }}</h3>
                    </div>
                    <div class="card-body">
                        <p class="text-secondary">{{ 'wiki.import_export.intro'|trans({}, 'NowoWikiBundle') }}</p>
                        {% if can_export %}
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <a href="{{ path(routes.space_export.name, {spaceSlug: space.slug, format: 'outline'}) }}" class="btn btn-outline-primary">
                                    <i class="ti ti-download me-1" aria-hidden="true"></i>{{ 'wiki.export.outline'|trans({}, 'NowoWikiBundle') }}
                                </a>
                                <a href="{{ path(routes.space_export.name, {spaceSlug: space.slug, format: 'notion'}) }}" class="btn btn-outline-primary">
                                    <i class="ti ti-download me-1" aria-hidden="true"></i>{{ 'wiki.export.notion'|trans({}, 'NowoWikiBundle') }}
                                </a>
                            </div>
                        {% endif %}
                        {% if can_import %}
                            {# REQ-TWIG-005: WikiImportType (multipart, flat format / archive / update_existing / _token). #}
                            {{ form_start(import_form, {attr: {class: 'row g-2 align-items-end'}}) }}
                                <div class="col-md-4">
                                    {{ form_label(import_form.format) }}
                                    {{ form_widget(import_form.format) }}
                                </div>
                                <div class="col-md-5">
                                    {{ form_label(import_form.archive) }}
                                    {{ form_widget(import_form.archive) }}
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check mb-2">
                                        {{ form_widget(import_form.update_existing) }}
                                        {{ form_label(import_form.update_existing) }}
                                    </div>
                                    {% for child in import_form %}
                                        {% if not child.rendered %}
                                            {{ form_row(child) }}
                                        {% endif %}
                                    {% endfor %}
                                    <button type="submit" class="btn btn-primary w-100">{{ 'wiki.import.submit'|trans({}, 'NowoWikiBundle') }}</button>
                                </div>
                            {{ form_end(import_form) }}
                            <p class="small text-secondary mt-2 mb-0">{{ 'wiki.import.help'|trans({}, 'NowoWikiBundle') }}</p>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
