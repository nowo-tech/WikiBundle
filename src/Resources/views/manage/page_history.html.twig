{% extends '@NowoWikiBundle/base.html.twig' %}

{% block title %}{{ 'wiki.history.title'|trans({}, 'NowoWikiBundle') }} — {{ page.title }}{% endblock %}

{% block body %}
    {{ include('@NowoWikiBundle/manage/_page_header.html.twig', {
        page_title: 'wiki.history.title'|trans({}, 'NowoWikiBundle'),
        page_subtitle: page.title,
    }) }}

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-vcenter card-table mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>{{ 'wiki.history.created'|trans({}, 'NowoWikiBundle') }}</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for revision in revisions %}
                            <tr>
                                <td>{{ revision.revisionNumber }}</td>
                                <td>{{ revision.createdAt|date('Y-m-d H:i') }}</td>
                                <td class="text-end">
                                    {% set older = loop.last ? older_revision|default(null) : revisions[loop.index] %}
                                    {% if older is not null %}
                                        <a href="{{ path(routes.page_diff.name, {spaceSlug: space.slug, pageSlug: page.slug, from: older.revisionNumber, to: revision.revisionNumber}) }}" class="btn btn-sm btn-outline-primary">
                                            {{ 'wiki.history.diff'|trans({}, 'NowoWikiBundle') }}
                                        </a>
                                    {% endif %}
                                    {% if restore_forms[revision.revisionNumber] is defined %}
                                        {{ form_start(restore_forms[revision.revisionNumber], {attr: {class: 'd-inline nowo-wiki-history__restore'}}) }}
                                            {{ form_rest(restore_forms[revision.revisionNumber]) }}
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">{{ 'wiki.history.restore'|trans({}, 'NowoWikiBundle') }}</button>
                                        {{ form_end(restore_forms[revision.revisionNumber]) }}
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% if pagination is defined %}
            <div class="card-body pt-0">
                {{ include('@NowoWikiBundle/manage/_pagination.html.twig', {
                    route: routes.page_history.name,
                    route_params: {spaceSlug: space.slug, pageSlug: page.slug},
                    page: pagination.page,
                    has_previous: pagination.has_previous,
                    has_next: pagination.has_next,
                }, false) }}
            </div>
        {% endif %}
        <div class="card-footer">
            <a href="{{ path(routes.page_view.name, {spaceSlug: space.slug, pageSlug: page.slug}) }}" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1" aria-hidden="true"></i>{{ page.title }}
            </a>
        </div>
    </div>
{% endblock %}
