{#
  Version history (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from WikiPageFactory::history():
  header wiki.history.title / page title with a back link to the page, breadcrumbs; columns revision, created; rows
  {id, number, created, current}; row actions Compare (diff with the next older revision) and Restore (POST + CSRF
  behind a UiKit confirm dialog; not on the current revision); Pagination (pagination.revisions_per_page)).
  Blocks filled: nowo_ui_styles, nowo_ui_list_row (the current revision gets a badge).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoWikiBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('wiki.css', 'nowo_wiki') }}">
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _cell = nowo_ui_class('table_cell', page.bundle) %}
    <td class="{{ _cell }}" data-label="{{ 'wiki.history.revision'|trans }}" data-required="1" data-wiki-revision="{{ row.id }}">
        {{ row.number }}
        {% if row.current %}<span class="{{ nowo_ui_class('badge_success', page.bundle) }}">{{ 'wiki.history.current'|trans }}</span>{% endif %}
    </td>
    <td class="{{ _cell }}" data-label="{{ 'wiki.history.created'|trans }}">{{ row.created }}</td>
{% endblock %}
