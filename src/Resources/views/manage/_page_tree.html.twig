{#
  Page tree of a space (one level per include; override `_page_tree_item.html.twig` to change one item). Value-free nodes
  from WikiPageFactory::tree(): {title, href, current, children}. Variables: nodes, depth (0-based, default 0).
  Indentation comes from the nesting (wiki.css); `nowo-wiki-tree__item--depth-N` is capped at 6.
#}
{% set depth = depth|default(0) %}
<ul class="nowo-wiki-tree{{ depth > 0 ? ' nowo-wiki-tree--nested' }}"{% if depth == 0 %} data-wiki-tree{% endif %}>
    {% for node in nodes %}
        {{ include('@NowoWikiBundle/manage/_page_tree_item.html.twig', {node: node, depth: depth}, false) }}
    {% endfor %}
</ul>
