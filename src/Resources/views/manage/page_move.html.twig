{#
  Move a page (1.14, tree.enabled): UiKit form scaffold. Variable: page (View\FormPage from WikiPageFactory::pageMove():
  header wiki.tree.move_title, breadcrumbs, back link; form = WikiPageMoveType (parent, position, CSRF token
  wiki_move_<page id>); submit wiki.tree.move). The single-pointer and no-JavaScript alternative to dragging in the tree.
  Also: error (translated message of a refused move, or null).
  Blocks filled: nowo_ui_styles, nowo_ui_form_body (the error, then the REQ-TWIG-003 child loop).
#}
{% extends '@NowoUiKit/page/form.html.twig' %}
{% trans_default_domain 'NowoWikiBundle' %}

{% block nowo_ui_styles %}
    {#- 1.21 web_ui.assets.styles: false = the host bundles the assets (nothing printed here) -#}
    {% if nowo_wiki_web_ui.assets.styles ?? true %}
        {{ parent() }}
        <link rel="stylesheet" href="{{ asset('wiki.css', 'nowo_wiki') }}">
    {% endif %}
{% endblock %}

{% block nowo_ui_scripts %}
    {#- 1.21 web_ui.assets.scripts: false = the host bundles the assets (nothing printed here) -#}
    {% if nowo_wiki_web_ui.assets.scripts ?? true %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block nowo_ui_form_body %}
    {% if error|default(null) %}
        <div class="{{ nowo_ui_class('flash_warning', page.bundle) }}" role="alert" data-testid="wiki-move-error">{{ error }}</div>
    {% endif %}
    {{ parent() }}
{% endblock %}
