{#
  1.30 (web_ui.children): "Pages in this section", after the page body: the readable direct sub-pages in tree order, a
  compact list with an icon (UiKit `icon` component) and the title. page_children.mode auto: shown only while the tree
  is collapsed or on one column (wiki.css).
  Variables: page_children ({mode, items: list of {label, href}}), bundle.
#}
{% trans_default_domain 'NowoWikiBundle' %}
{% set _b = bundle|default(null) %}
{% set _children = page_children|default(null) %}
{% if _children and _children.items is not empty %}
<section class="{{ nowo_ui_class('card', _b) }} nowo-wiki-children{{ _children.mode == 'auto' ? ' nowo-wiki-children--auto' }}" aria-labelledby="nowo-wiki-children-title" data-testid="wiki-children"{{ nowo_ui_attrs('card', _b) }}>
    <header class="{{ nowo_ui_class('card_header', _b) }}">
        <h2 class="{{ nowo_ui_class('card_title', _b) }} nowo-wiki-region-title" id="nowo-wiki-children-title">{{ 'wiki.children.title'|trans }}</h2>
    </header>
    <ul class="{{ nowo_ui_class('card_body', _b) }} nowo-wiki-children__list">
        {% for child in _children.items %}
            <li class="nowo-wiki-children__item">
                <a class="nowo-wiki-children__link" href="{{ child.href }}"><span class="nowo-wiki-children__icon" aria-hidden="true">{{ include('@NowoUiKitBundle/components/_icon.html.twig', {name: 'book', label: ''}, false)|trim|raw }}</span><span class="nowo-wiki-children__label">{{ child.label }}</span></a>
            </li>
        {% endfor %}
    </ul>
    {% if _children.truncated|default(false) %}<p class="{{ nowo_ui_class('muted', _b) }} nowo-wiki-children__more" data-testid="wiki-children-more">{{ 'wiki.children.count_more'|trans({'%count%': _children.items|length}) }}</p>{% endif %}
</section>
{% endif %}
