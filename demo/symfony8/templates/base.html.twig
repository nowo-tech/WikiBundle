{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig).
    This file only declares the demo (nowo_ui_demo_platform); wiki pages extend it through nowo_ui_kit.layouts. UiKit's
    shell focus mode (config/packages/nowo_ui_kit.yaml) is printed by the shell itself. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Wiki',
    home_route: 'nowo_wiki_index',
    repository: 'https://github.com/nowo-tech/WikiBundle',
    translation_domain: false,
    nav: [
        {label: 'Spaces', route: 'nowo_wiki_index', active: ['nowo_wiki_index', 'nowo_wiki_space*', 'nowo_wiki_page_*'], section: 'Wiki'},
        {label: 'Search', route: 'nowo_wiki_search', section: 'Wiki'},
        {label: 'Ask the wiki', route: 'nowo_wiki_ai_ask', section: 'Wiki'},
    ],
} %}
{% block nowo_ui_document_title %}{% block title %}Wiki Bundle Demo{% endblock %} — Symfony 8{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {% block javascripts %}{% endblock %}
{% endblock %}
