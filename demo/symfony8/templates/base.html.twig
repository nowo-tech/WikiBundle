{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package; no CSS framework, no CDN, no global token override). Wiki pages extend it through
    nowo_ui_kit.layouts.admin and fill the canonical blocks. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% set nowo_ui_document_title_suffix = 'Wiki Demo' %}

{% block nowo_ui_document_title %}{% block title %}Wiki Bundle Demo{% endblock %}{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {% block stylesheets %}{% endblock %}
{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('nowo_wiki_index') }}">Wiki Bundle Demo</a>
        <nav class="nowo-ui-menu" aria-label="Wiki Bundle Demo">
            <a class="nowo-ui-link" href="{{ path('nowo_wiki_index') }}"{% if _route == 'nowo_wiki_index' %} aria-current="page"{% endif %}>Spaces</a>
            <a class="nowo-ui-link" href="{{ path('nowo_wiki_search') }}"{% if _route == 'nowo_wiki_search' %} aria-current="page"{% endif %}>Search</a>
            <a class="nowo-ui-link" href="{{ path('nowo_wiki_ai_ask') }}"{% if _route == 'nowo_wiki_ai_ask' %} aria-current="page"{% endif %}>Ask the wiki</a>
        </nav>
        <div class="nowo-ui-header__end">
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {% block javascripts %}{% endblock %}
{% endblock %}
