<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Wiki Bundle Demo{% endblock %}</title>
    {# Demo only: the host app owns the CSS stack (nowo_ui_kit.css_framework: bootstrap5); the bundle loads no CDN. #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/demo.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark demo-masthead" data-testid="demo-masthead">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ path('nowo_wiki_index') }}"><i class="bi bi-journal-richtext me-2" aria-hidden="true"></i>Wiki Bundle Demo</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="{{ path('nowo_wiki_index') }}">Spaces</a>
                <a class="nav-link" href="{{ path('nowo_wiki_search') }}">Search</a>
                <a class="nav-link" href="{{ path('nowo_wiki_ai_ask') }}">Ask the wiki</a>
            </div>
        </div>
    </nav>
    <main class="container-xl py-4">
        {% block body %}{% endblock %}
    </main>
    {% block javascripts %}{% endblock %}
</body>
</html>
